{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cua.ai/schemas/visual-perception-demo-evidence-v2.json",
  "title": "Authorized visual perception demo evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "raw_evidence_sha256", "fixture", "runtime", "observation", "os", "result", "artifacts"],
  "properties": {
    "schema": { "const": "cua-visual-perception-demo-evidence/v2" },
    "platform": { "enum": ["windows", "linux-x11", "macos"] },
    "raw_evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "oracle"],
      "properties": {
        "id": { "const": "visual-only-canvas/v1" },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "action_count"],
          "properties": {
            "selected": { "enum": ["save", "send", "cancel"] },
            "action_count": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "perception", "chooser"],
      "properties": {
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha", "binary_sha256"],
          "properties": {
            "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "perception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extension_id", "extension_version", "trust", "publisher_id", "publisher_key_id", "catalog_version", "signature_algorithm", "signed_extension_archive_sha256", "signing_key_sha256", "signed_catalog_sha256", "model_id", "model_sha256"],
          "properties": {
            "extension_id": { "const": "cua-perception" },
            "extension_version": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
            "trust": { "const": "review-only-publisher-verified" },
            "publisher_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
            "publisher_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
            "catalog_version": { "type": "integer", "minimum": 1 },
            "signature_algorithm": { "const": "ed25519" },
            "signed_extension_archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signing_key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signed_catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "model_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
            "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "chooser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provider", "model_id", "adapter_source_sha", "source_sha"],
          "properties": {
            "mode": { "enum": ["mock", "live"] },
            "provider": { "enum": ["fixture", "typesafe"] },
            "model_id": {
              "type": ["string", "null"],
              "pattern": "^[A-Za-z0-9._:/-]{1,96}$"
            },
            "adapter_source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_label", "acted_capture_id_sha256", "fresh_capture_id_sha256"],
      "properties": {
        "session_label": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
        "acted_capture_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fresh_capture_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "arch"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
        "arch": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "selected_candidate", "stale_capture_refused"],
      "properties": {
        "status": { "const": "passed" },
        "selected_candidate": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,96}$" },
        "stale_capture_refused": { "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size_bytes"],
        "properties": {
          "kind": { "const": "video" },
          "path": { "const": "recording.mp4" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
        }
      }
    }
  }
}
