2026-10-31T02:30:26.8966150Z   first="$(printf '%s\n' "$WORKSPACES" | sed -n '/[^[:space:]]/{p;q;}' | sed 's/->.*//; s/[[:space:]]//g')"
2026-10-31T02:30:26.8967210Z   fam="${first:-root}"
2026-10-31T02:30:26.8967730Z fi
2026-10-31T02:30:26.8968330Z fam="$(printf '%s' "$fam" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)"
2026-10-31T02:30:26.8969320Z # Who saves. main saves on every OS (pushes, schedules and manual
2026-10-31T02:30:26.8970350Z # runs). A manual run on another branch saves too, into that branch's
2026-10-31T02:30:26.8971360Z # own scope: it is how a change to a workflow's cache is measured
2026-10-31T02:30:26.8972340Z # before it merges (run it twice and read the second run). Pull
2026-10-31T02:30:26.8973370Z # requests restore main's cache and save only when the pr-save input
2026-10-31T02:30:26.8974250Z # is "true", and then only on Linux.
2026-10-31T02:30:26.8974850Z save=false
2026-10-31T02:30:26.8975390Z if [ "$REF" = refs/heads/main ]; then save=true
2026-10-31T02:30:26.8976210Z elif [ "$EVENT" = workflow_dispatch ]; then save=true
2026-10-31T02:30:26.8977170Z elif [ "$PR_SAVE" = true ] && [ "$RUNNER_OS" = Linux ]; then save=true; fi
2026-10-31T02:30:26.8978030Z [ "$SAVE_IF" = false ] && save=false
2026-10-31T02:30:26.8978660Z dir="$RUNNER_TEMP/sccache"
2026-10-31T02:30:26.8979530Z # The prefix ends in "_", which the family never contains (it is
2026-10-31T02:30:26.8980830Z # reduced to letters, digits and "-"). With a "-" the family libs-cua
2026-10-31T02:30:26.8982000Z # was a prefix of libs-cua-build-fixtures, libs-cua-lint and the rest,
2026-10-31T02:30:26.8983010Z # and a run restored a sibling's entry instead of its own.
2026-10-31T02:30:26.8983910Z prefix="sccache-v2-$RUNNER_OS-$RUNNER_ARCH-${fam}_"
2026-10-31T02:30:26.8984860Z # One key per family per UTC day. A key with the commit sha was new on
2026-10-31T02:30:26.8987110Z # every push, so every main push saved a full copy of every family and
2026-10-31T02:30:26.8989080Z # the 50 GB budget turned over several times an hour. With the day in
2026-10-31T02:30:26.8990170Z # the key the first main run of the day saves, later runs that day see
2026-10-31T02:30:26.8991210Z # an exact hit and skip the save, and everything else restores the
2026-10-31T02:30:26.8992050Z # newest entry through the prefix.
2026-10-31T02:30:26.8992680Z bucket="$(date -u +%Y%m%d)"
2026-10-31T02:30:26.8993210Z {
2026-10-31T02:30:26.8993620Z   echo "family=$fam"
2026-10-31T02:30:26.8994130Z   echo "save=$save"
2026-10-31T02:30:26.8994630Z   echo "dir=$dir"
2026-10-31T02:30:26.8995140Z   echo "prefix=$prefix"
2026-10-31T02:30:26.8995690Z   echo "key=$prefix$bucket"
2026-10-31T02:30:26.8996250Z } >> "$GITHUB_OUTPUT"
2026-10-31T02:30:26.8996970Z echo "sccache plan: family=$fam key=$prefix$bucket save=$save"
2026-10-31T02:30:26.9062340Z shell: /bin/bash --noprofile --norc -e -o pipefail {0}
