    "CommandHandle\\.kill",
    "Commands\\.kill"
   ],
   "status": "implemented",
   "tests": [
    "cmd_background_kill",
    "cmd_kill_pid",
    "cmd_kill_other_user_process"
   ],
   "note": "Kill by handle or pid, idempotent, across users."
  },
  {
