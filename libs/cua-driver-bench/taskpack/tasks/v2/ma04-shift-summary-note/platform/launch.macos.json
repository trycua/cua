{
  "platform": "macos",
  "descriptor_version": "1",
  "semantics": {
    "task_id": "cua.v2.ma04-shift-summary-note",
    "task_version": "1.0.0",
    "brief": "brief.md",
    "reset": {
      "setup": [
        "${python}",
        "reset/setup.py",
        "--workspace",
        "${workspace}"
      ],
      "verify": [
        "${python}",
        "reset/verify.py",
        "--workspace",
        "${workspace}"
      ]
    },
    "evaluate": [
      "${python}",
      "evaluator/evaluate.py",
      "--workspace",
      "${workspace}",
      "--artifacts",
      "${artifacts}",
      "--result",
      "${result}",
      "--agent-exit-code",
      "${agent_exit_code}"
    ],
    "required_apps": [
      "Google Chrome",
      "TextEdit"
    ],
    "export": [
      "${python}",
      "reset/export.py",
      "--workspace",
      "${workspace}"
    ]
  },
  "workspace_root": "${HOME}/v2-ma04",
  "apps": [
    {
      "id": "site",
      "kind": "service",
      "role": "the task's local web app (loopback only)",
      "command": [
        "${python}",
        "${bundle}/../_kit/v2kit/serve.py",
        "--app",
        "${bundle}/app",
        "--state-dir",
        "${workspace}/state",
        "--port",
        "4504",
        "--initial",
        "${bundle}/app/initial-state.json"
      ],
      "ready": {
        "http": "http://127.0.0.1:4504/healthz",
        "timeout_seconds": 15
      }
    },
    {
      "id": "browser",
      "kind": "browser",
      "role": "Google Chrome on the task's local page",
      "command": [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-default-apps",
        "--disable-sync",
        "--disable-features=Translate,PasswordManagerOnboarding,AutofillServerCommunication",
        "--user-data-dir=${workspace}/.runtime/chrome",
        "--new-window",
        "http://127.0.0.1:4504/"
      ],
      "window": {
        "title_contains": "Brackenmoor Food Bank Rota",
        "bounds": {
          "x": 20,
          "y": 40,
          "width": 1240,
          "height": 900
        }
      }
    },
    {
      "id": "textedit",
      "kind": "native",
      "role": "TextEdit on the empty summary note",
      "command": [
        "/usr/bin/open",
        "-a",
        "TextEdit",
        "${workspace}/summary.rtf"
      ],
      "process_names": [
        "TextEdit"
      ],
      "window": {
        "title_contains": "summary.rtf",
        "bounds": {
          "x": 1270,
          "y": 40,
          "width": 630,
          "height": 900
        }
      }
    }
  ]
}
