diff --git a/dist/cjs/objects.js b/dist/cjs/objects.js
index ff892a8fa69e42e1a1458cba7a978c49d24b3a86..260cf1e4503e652aac983c46610094832929a9d1 100644
--- a/dist/cjs/objects.js
+++ b/dist/cjs/objects.js
@@ -72,10 +72,15 @@ class FfiConverterObjectWithCallbacks extends FfiConverterObject {
         this.handleMap = handleMap;
     }
     lower(value, alloc) {
-        // Rust-backed objects are lowered as raw Arc pointers (even numbers).
-        // TS-implemented objects are inserted into the handleMap as foreign handles (odd numbers).
+        return this.lowerHandle(value);
+    }
+    // Rust-backed objects are lowered as raw Arc pointers (even numbers).
+    // TS-implemented objects are inserted into the handleMap as foreign handles (odd numbers).
+    // `write` lowers through here too, so an object inside an optional, a
+    // sequence or a record is lowered the same way as a bare argument.
+    lowerHandle(value) {
         if (this.factory.isConcreteType(value)) {
-            return super.lower(value, alloc);
+            return super.lowerHandle(value);
         }
         return this.handleMap.insert(value);
     }
