{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trycua/cua/.github/releases/cua-perception/provenance.schema.json",
  "title": "Cua Perception redacted candidate provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "candidate", "releaseStatus", "source", "build", "evidence", "subjects", "redactions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "component": { "const": "cua-perception" },
    "candidate": { "const": true },
    "releaseStatus": { "const": "staging-candidate" },
    "source": { "type": "object", "required": ["repository", "commit"] },
    "build": { "type": "object", "required": ["workflow", "runId", "target"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplied", "executed", "executedSha256"],
      "properties": {
        "supplied": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "executed": { "const": "metadata/executed-verification.json" },
        "executedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "subjects": { "type": "array", "minItems": 1 },
    "redactions": { "type": "array", "contains": { "const": "absolutePaths" } }
  }
}
