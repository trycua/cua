[
  "-name",
  "vm1",
  "-machine",
  "q35,smm=off,memory-backend=mem0",
  "-cpu",
  "host,hv_relaxed,hv_vapic,hv_spinlocks=0x1fff,hv_time,hv_vpindex,hv_synic,hv_stimer",
  "-accel",
  "kvm",
  "-smp",
  "2",
  "-m",
  "2048",
  "-object",
  "memory-backend-ram,id=mem0,size=2048M",
  "-drive",
  "file=/s/vm1/disk.qcow2,if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap",
  "-device",
  "ahci,id=ahci",
  "-device",
  "ide-hd,drive=disk0,bus=ahci.0,bootindex=1",
  "-drive",
  "file=/s/vm1/seed.iso,if=none,id=cidata,format=raw,readonly=on",
  "-device",
  "virtio-blk-pci,drive=cidata",
  "-cdrom",
  "/install.iso",
  "-boot",
  "d",
  "-netdev",
  "user,id=net0,hostfwd=tcp:127.0.0.1:40022-:22,hostfwd=tcp:127.0.0.1:40080-:8080",
  "-device",
  "virtio-net-pci,netdev=net0",
  "-vga",
  "std",
  "-device",
  "qemu-xhci,id=xhci",
  "-device",
  "usb-kbd",
  "-device",
  "usb-tablet",
  "-display",
  "none",
  "-vnc",
  "127.0.0.1:3",
  "-qmp",
  "tcp:127.0.0.1:4444,server=on,wait=off",
  "-serial",
  "file:/s/vm1/serial.log",
  "-monitor",
  "none",
  "-pidfile",
  "/s/vm1/qemu.pid",
  "-daemonize"
]