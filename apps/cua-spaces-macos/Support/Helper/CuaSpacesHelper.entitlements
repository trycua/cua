<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cua Spaces Helper.app (com.trycua.spaces.helper), Developer ID with the
  hardened runtime (scripts/build-release.sh). macOS holds the helper
  responsible for its cua-spacesd child, so the child's App Teleport
  (osascript driving browsers) needs Apple Events allowed here, as for the
  app (CuaSpacesMac.entitlements). Nothing else: no JIT, library validation
  on, no keychain access groups. Screen Recording, Accessibility and Local
  Network are TCC prompts, not entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
