{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trycua/cua/.github/releases/cua-perception/provenance.schema.json",
  "title": "Cua Perception redacted candidate provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "candidate", "releaseStatus", "source", "build", "subjects", "redactions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "component": { "const": "cua-perception" },
    "candidate": { "const": true },
    "releaseStatus": { "const": "staging-candidate" },
    "source": { "type": "object", "required": ["repository", "commit"] },
    "build": { "type": "object", "required": ["workflow", "runId", "target"] },
    "subjects": { "type": "array", "minItems": 1 },
    "redactions": { "type": "array", "contains": { "const": "absolutePaths" } }
  }
}
