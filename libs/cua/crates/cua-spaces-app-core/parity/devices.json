          { "id": "dev_a", "name": "Studio", "state": "enrolled", "enrolledUntil": 1801000000, "platform": "linux" }
        ],
        "localDeviceId": "dev_m",
        "pendingCode": "K7QX-M2RP"
      }
    },
    {
