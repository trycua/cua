{
 "preamble": "# E2B coverage matrix\n\nEvery public symbol of the E2B Python SDK (sync and async) and the `e2b` npm package, and what the Cua gateway (`cua-compat`) does with it. Generated by `tests/compat/e2b/coverage.py` from the committed SDK surface snapshots and `coverage.json`; `coverage.py --check` fails when an SDK release adds a symbol no row covers.\n\nStatus: **implemented** (tested by the named cases, which run against the real E2B and the gateway), **native-error** (E2B's own error shape, with the reason).",
 "sections": [
  "Commands and processes",
  "Filesystem",
  "Sandbox lifecycle",
  "Network and URLs",
  "Platform: templates, secrets, volumes",
  "Errors",
  "REST and envd routes"
 ],
 "rules": [
  {
   "id": "m-commands-run",
   "section": "Commands and processes",
   "match": [
    "Commands\\.run"
   ],
   "status": "implemented",
   "tests": [
    "cmd_run_basic",
    "cmd_exit_codes",
    "cmd_users",
    "cmd_envs",
    "cmd_envs_override",
    "cmd_cwd",
    "cmd_timeout",
    "cmd_timeout_process_survives",
    "cmd_stream_order",
    "cmd_stream_chunking",
    "cmd_large_output",
    "cmd_binary_unicode_output",
    "cmd_special_cmds",
    "cmd_shell_environment",
    "cmd_parallel"
   ],
   "note": "Foreground and background; envs, cwd, user, timeouts, exit codes and signals, ordered output, big and binary output."
  },
  {
   "id": "m-handle-wait",
   "section": "Commands and processes",
   "match": [
    "CommandHandle\\.(wait|stdout|stderr|exit_code|error|pid)"
   ],
   "status": "implemented",
   "tests": [
    "cmd_background",
    "cmd_background_nonzero",
    "cmd_exit_exception_fields",
    "cmd_long_running_stream"
   ],
   "note": "Result, exit code and error of background commands; CommandExitException fields."
  },
  {
   "id": "m-handle-kill",
   "section": "Commands and processes",
