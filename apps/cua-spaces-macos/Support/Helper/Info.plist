<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cua Spaces.app/Contents/Library/LoginItems/Cua Spaces Helper.app: the host
  service (cua-spacesd) as the app's login item. Its name and icon are what
  System Settings shows in Privacy & Security (Screen Recording,
  Accessibility, Local Network) and Login Items. scripts/build-app.sh sets
  the versions to the app's.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Cua Spaces Helper</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.trycua.spaces.helper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Cua Spaces Helper</string>
	<key>CFBundleDisplayName</key>
	<string>Cua Spaces Helper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Cua Spaces Helper shows this screen to the people and agents you share this Mac with.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>Cua Spaces Helper lets the people and agents you share this Mac with use its mouse and keyboard.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cua Spaces Helper connects to the Spaces this Mac runs for your other devices.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Cua Spaces Helper moves the browser sessions you choose into a Space.</string>
</dict>
</plist>
