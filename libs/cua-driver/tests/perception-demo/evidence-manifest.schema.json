{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cua.ai/schemas/visual-perception-demo-evidence-v1.json",
  "title": "Authorized visual perception demo evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_sha", "platform", "fixture", "runtime", "result", "artifacts"],
  "properties": {
    "schema": { "const": "cua-visual-perception-demo-evidence/v1" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": { "enum": ["windows", "linux-x11"] },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "oracle"],
      "properties": {
        "id": { "const": "visual-only-canvas/v1" },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "action_count"],
          "properties": {
            "selected": { "enum": ["ember", "tide", "moss"] },
            "action_count": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model_id", "signed_extension_sha256"],
      "properties": {
        "adapter": { "const": "jev-use" },
        "model_id": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,96}$" },
        "signed_extension_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "passed" } }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size_bytes"],
        "properties": {
          "kind": { "const": "video" },
          "path": { "const": "recording.mp4" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
        }
      }
    }
  }
}
