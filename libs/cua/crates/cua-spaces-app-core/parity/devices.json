          { "ts": 1799990200, "kind": "shared_access", "machine": "m1", "subject": "bob@example.com" },
          { "ts": 1799990300, "kind": "device_registered", "device": "dev_p" },
          { "ts": 1799990400, "kind": "machine_access", "machine": "m2", "subject": "unenrolled device" },
          { "ts": 1799990500, "kind": "device_revoked", "device": "dev_m", "subject": "dev_x" }
