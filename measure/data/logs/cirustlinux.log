2026-10-31T21:06:54.4112748Z ##[group]Run set -eu
2026-10-31T21:06:54.4113014Z set -eu
2026-10-31T21:06:54.4113227Z fam="$SHARED"
2026-10-31T21:06:54.4113455Z if [ -z "$fam" ]; then
2026-10-31T21:06:54.4113915Z   first="$(printf '%s\n' "$WORKSPACES" | sed -n '/[^[:space:]]/{p;q;}' | sed 's/->.*//; s/[[:space:]]//g')"
2026-10-31T21:06:54.4114479Z   fam="${first:-root}"
2026-10-31T21:06:54.4114717Z fi
2026-10-31T21:06:54.4115084Z fam="$(printf '%s' "$fam" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)"
2026-10-31T21:06:54.4115574Z # Who saves. main saves on every OS (pushes, schedules and manual
2026-10-31T21:06:54.4116057Z # runs). A manual run on another branch saves too, into that branch's
2026-10-31T21:06:54.4116521Z # own scope: it is how a change to a workflow's cache is measured
2026-10-31T21:06:54.4116965Z # before it merges (run it twice and read the second run). Pull
2026-10-31T21:06:54.4117530Z # requests restore main's cache and save only when the pr-save input
2026-10-31T21:06:54.4117943Z # is "true", and then only on Linux.
2026-10-31T21:06:54.4118284Z save=false
2026-10-31T21:06:54.4118533Z if [ "$REF" = refs/heads/main ]; then save=true
2026-10-31T21:06:54.4119210Z elif [ "$EVENT" = workflow_dispatch ]; then save=true
2026-10-31T21:06:54.4119641Z elif [ "$PR_SAVE" = true ] && [ "$RUNNER_OS" = Linux ]; then save=true; fi
2026-10-31T21:06:54.4120033Z [ "$SAVE_IF" = false ] && save=false
2026-10-31T21:06:54.4120321Z dir="$RUNNER_TEMP/sccache"
2026-10-31T21:06:54.4120670Z # The prefix ends in "_", which the family never contains (it is
2026-10-31T21:06:54.4121426Z # reduced to letters, digits and "-"). With a "-" the family libs-cua
2026-10-31T21:06:54.4121991Z # was a prefix of libs-cua-build-fixtures, libs-cua-lint and the rest,
2026-10-31T21:06:54.4122442Z # and a run restored a sibling's entry instead of its own.
2026-10-31T21:06:54.4122853Z prefix="sccache-v2-$RUNNER_OS-$RUNNER_ARCH-${fam}_"
2026-10-31T21:06:54.4123291Z # One key per family per UTC day. A key with the commit sha was new on
2026-10-31T21:06:54.4123776Z # every push, so every main push saved a full copy of every family and
2026-10-31T21:06:54.4124245Z # the 50 GB budget turned over several times an hour. With the day in
2026-10-31T21:06:54.4124781Z # the key the first main run of the day saves, later runs that day see
2026-10-31T21:06:54.4125481Z # an exact hit and skip the save, and everything else restores the
2026-10-31T21:06:54.4125905Z # newest entry through the prefix.
2026-10-31T21:06:54.4126199Z bucket="$(date -u +%Y%m%d)"
2026-10-31T21:06:54.4126454Z {
2026-10-31T21:06:54.4126654Z   echo "family=$fam"
2026-10-31T21:06:54.4126896Z   echo "save=$save"
2026-10-31T21:06:54.4127131Z   echo "dir=$dir"
2026-10-31T21:06:54.4127366Z   echo "prefix=$prefix"
2026-10-31T21:06:54.4127712Z   echo "key=$prefix$bucket"
2026-10-31T21:06:54.4127972Z } >> "$GITHUB_OUTPUT"
2026-10-31T21:06:54.4128377Z echo "sccache plan: family=$fam key=$prefix$bucket save=$save"
