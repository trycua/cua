    "allowed": [
      {
        "scope": "workspace.cases.candidates",
        "description": "Update status, direct duplicate link, and structured evidence fields on the four named candidate cases."
      },
      {
        "scope": "workspace.runtime",
        "description": "Operate the two Electron apps, loopback archive service, browser, terminal or shell, and task-scoped runtime profiles."
      }
    ],
    "forbidden": [
      {
        "scope": "workspace.cases.root",
        "description": "Change root case RWC-184."
      },
      {
        "scope": "workspace.cases.unsupported",
        "description": "Close, link, or otherwise change an unsupported candidate or unrelated case."
      },
      {
        "scope": "workspace.cases.immutable",
        "description": "Change case identities, titles, descriptions, components, or timestamps."
      },
      {
        "scope": "workspace.sources",
        "description": "Change the wiki, archive site, record data, access log, or workspace facts."
      },
      {
        "scope": "network.external",
        "description": "Reach any non-loopback host."
      }
    ]
  },
