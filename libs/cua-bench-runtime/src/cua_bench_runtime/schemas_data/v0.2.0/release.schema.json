{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cua.ai/cuabench/v0.2.0/release.schema.json",
  "title": "Cua-Bench Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "created_at",
    "decision_bearing",
    "inputs",
    "digest"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "created_at": { "type": "string", "format": "date-time" },
    "decision_bearing": { "const": true },
    "inputs": { "$ref": "#/$defs/releaseInputs" },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "datasetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest", "freeze_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "manifest": { "$ref": "#/$defs/artifact" },
        "freeze_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "sources_consulted"],
      "properties": {
        "original": { "type": "boolean" },
        "sources_consulted": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtimeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_revision", "artifact"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "apparatusInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "provenance",
        "harness_builds",
        "environment_images",
        "observers",
        "evaluators",
        "normalized_facade_contract",
        "neutral_instructions"
      ],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "harness_builds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "environment_images": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "observers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "evaluators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "normalized_facade_contract": { "$ref": "#/$defs/artifact" },
        "neutral_instructions": { "$ref": "#/$defs/artifact" }
      }
    },
    "profileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest"],
      "properties": {
        "id": {
          "enum": [
            "native-bundle",
            "bare-driver",
            "harness-native-reference",
            "normalized-facade",
            "driver-only-diagnostic"
          ]
        },
        "version": { "$ref": "#/$defs/semver" },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "trialInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile_id",
        "comparison_candidate_id",
        "pairing_key",
        "manifest"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profile_id": {
          "enum": [
            "native-bundle",
            "bare-driver",
            "harness-native-reference",
            "normalized-facade",
            "driver-only-diagnostic"
          ]
        },
        "comparison_candidate_id": { "$ref": "#/$defs/id" },
        "pairing_key": { "type": "string", "minLength": 1 },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "toolSurfaceArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "trials", "result"],
      "properties": {
        "id": { "enum": ["consolidated", "factored", "fine-grained"] },
        "contract": { "$ref": "#/$defs/artifact" },
        "trials": { "$ref": "#/$defs/artifact" },
        "result": { "$ref": "#/$defs/artifact" }
      }
    },
    "toolSurfaceStudy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "capabilities",
        "capability_digest",
        "harness_kind",
        "guidance_mode",
        "arms"
      ],
      "properties": {
        "backend": { "$ref": "#/$defs/versionedArtifact" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "capability.schema.json" }
        },
        "capability_digest": { "$ref": "#/$defs/sha256" },
        "harness_kind": { "const": "full" },
        "guidance_mode": { "const": "removed" },
        "arms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/toolSurfaceArm" }
        }
      }
    },
    "releaseInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "dataset",
        "apparatus",
        "profiles",
        "candidates",
        "trials",
        "report_inputs",
        "tool_surface_study"
      ],
      "properties": {
        "runtime": { "$ref": "#/$defs/runtimeInput" },
        "dataset": { "$ref": "#/$defs/datasetInput" },
        "apparatus": { "$ref": "#/$defs/apparatusInput" },
        "profiles": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/profileInput" }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/versionedArtifact" }
        },
        "trials": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/trialInput" }
        },
        "report_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "tool_surface_study": { "$ref": "#/$defs/toolSurfaceStudy" }
      }
    }
  }
}
