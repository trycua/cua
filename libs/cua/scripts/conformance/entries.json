{
  "cases": [
    {
      "case": "ready",
      "what": "time from create to a Space that answers"
    },
    {
      "case": "policy",
      "what": "the default network holds: internet yes; host, LAN, cloud metadata, other trees no, and each refusal is in the network log with its destination and time"
    },
    {
      "case": "dns",
      "what": "a Space resolves names and downloads over https, on the secure and the default network; with no network the lookup fails at once"
    },
    {
      "case": "download",
      "what": "the guest downloads the coding app's package"
    },
    {
      "case": "registry",
      "what": "a private image is pulled with the host-held registry credential"
    },
    {
      "case": "children",
      "what": "a home creates, lists, uses and deletes a child Space, audited"
    },
    {
      "case": "agent",
      "what": "a coding agent session starts and answers"
    },
    {
      "case": "lifecycle",
      "what": "stop and resume, and the declared pause, checkpoint and fork"
    },
    {
      "case": "warm",
      "what": "a Space claimed from a warm member answers with its own token and only that one, or the runtime says it starts cold"
    },
    {
      "case": "teardown",
      "what": "delete leaves no Space, process, container or network"
    }
  ],
