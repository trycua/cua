{
  "platform": "macos",
  "descriptor_version": "1",
  "semantics": {
    "task_id": "cua.v2.na03-seed-packet-tags",
    "task_version": "1.0.0",
    "brief": "brief.md",
    "reset": {
      "setup": [
        "${python}",
        "reset/setup.py",
        "--workspace",
        "${workspace}",
        "--apply-app-state"
      ],
      "verify": [
        "${python}",
        "reset/verify.py",
        "--workspace",
        "${workspace}"
      ]
    },
    "evaluate": [
      "${python}",
      "evaluator/evaluate.py",
      "--workspace",
      "${workspace}",
      "--artifacts",
      "${artifacts}",
      "--result",
      "${result}",
      "--agent-exit-code",
      "${agent_exit_code}"
    ],
    "required_apps": [
      "Finder"
    ],
    "export": [
      "${python}",
      "reset/export.py",
      "--workspace",
      "${workspace}"
    ]
  },
  "workspace_root": "${HOME}/v2-na03",
  "apps": [
    {
      "id": "finder",
      "kind": "native",
      "role": "Finder",
      "command": [
        "/usr/bin/open",
        "${workspace}/Seed packets 2026"
      ],
      "process_names": [],
      "window": {
        "title_contains": "Seed packets 2026",
        "bounds": {
          "x": 60,
          "y": 60,
          "width": 1100,
          "height": 760
        }
      }
    }
  ]
}
