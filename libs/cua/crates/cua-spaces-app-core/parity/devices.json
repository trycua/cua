          { "id": "m1", "name": "studio-mac", "confirmed": true },
          { "id": "m2", "name": "build-box", "confirmed": false }
        ]
      }
    },
    {
      "step": "re-verification in two days",
      "input": {
        "devices": [
          { "id": "dev_m", "name": "MacBook Pro", "state": "enrolled", "current": true, "enrolledUntil": 1800172800, "platform": "macos" }
        ]
      }
    },
    {
      "step": "enrolled, a new device and an expired one ask (again, for the sheets)",
      "input": {
        "devices": [
          { "id": "dev_p", "name": "Work laptop", "state": "pending", "platform": "windows" },
          { "id": "dev_m", "name": "MacBook Pro", "state": "enrolled", "current": true, "enrolledUntil": 1802592000, "platform": "macos" },
          { "id": "dev_o", "name": "Old laptop", "state": "expired", "enrolledUntil": 1799900000, "platform": "linux" }
