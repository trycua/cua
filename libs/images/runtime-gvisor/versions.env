# Pinned inputs of ghcr.io/trycua/runtime-gvisor: the disk of the built-in
# Linux runtime VM (cua_vmm::managed). One place: a rebuild changes nothing
# unless this file changes. Every download is checked against its digest
# before it is used. cua-vmm's managed.rs pins the same Colima, Lima and
# image digests (a test there reads this file).
# Sourced by bash; KEY=value only.

# The image's own version (its tag is <version>, pre-releases <version>-rcN).
RUNTIME_VERSION=0.1.0

# The base disk: Colima's own Ubuntu 24.04 minimal cloud image with Docker
# Engine and containerd, the one Colima COLIMA_VERSION verifies by default.
COLIMA_CORE_VERSION=0.10.4
BASE_URL_arm64=https://github.com/abiosoft/colima-core/releases/download/v0.10.4/ubuntu-24.04-minimal-cloudimg-arm64-docker.raw.gz
BASE_SHA512_arm64=32242674b046b5057e60c4aba334b51e3665f05412cda89ed081cc2de153ae5c41f6b105b5c442cbe48d78e2cc21e9ba1950e406b6fb4fc2fd1dd2259240abbd
BASE_URL_amd64=https://github.com/abiosoft/colima-core/releases/download/v0.10.4/ubuntu-24.04-minimal-cloudimg-amd64-docker.raw.gz
BASE_SHA512_amd64=27652801b6606b457f4f34836358c0e9978aeb98757d0271165e3f09672f930ccc2d957e15726f7e7f22c302b20a3d30c64ead68adaa5f24a4f959cd34b56b5b

# gVisor: runsc (the default Docker runtime) and its sentry sidecar, from the
# release tarball (scripts/images/install-gvisor.sh pins the same release).
GVISOR_VERSION=20260921.0
GVISOR_URL_arm64=https://storage.googleapis.com/gvisor/releases/release/20260921.0/aarch64/gvisor.tar.bz2
GVISOR_SHA512_arm64=9438f926b8fadee8c0b8c5c2c954cfc957618acd5d9e1d669e442a9366412dd8794e210b9ce8c7a880a49c8ee9f4f040943a11edae00893d2b22ca844c61de93
GVISOR_URL_amd64=https://storage.googleapis.com/gvisor/releases/release/20260921.0/x86_64/gvisor.tar.bz2
