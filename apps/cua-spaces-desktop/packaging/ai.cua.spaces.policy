<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  The prompts Cua asks the desktop for (`pkcheck --action-id ...`,
  crates/cua-teleport/src/biometric.rs): the Keyvault's before it lets a
  secret move or widens access (ai.cua.spaces.keyvault, asked by the cua
  daemon), and the Cua Spaces app's before it approves another device for
  the account (ai.cua.spaces.devices). The .deb installs this to
  /usr/share/polkit-1/actions/.

  auth_self: the user proves it is them, with their own password or
  fingerprint, in the session they are at, every time (the answer is not kept).
  Nothing here gives anyone root or any other right.
-->
<policyconfig>
  <vendor>Cua AI, Inc.</vendor>
  <vendor_url>https://cua.ai</vendor_url>
  <action id="ai.cua.spaces.keyvault">
    <description>Confirm access to the Cua Keyvault</description>
    <message>Confirm access to the Cua Keyvault: $(reason)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
  <action id="ai.cua.spaces.devices">
    <description>Approve a device for your Cua account</description>
    <message>Confirm it is you to $(reason)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
