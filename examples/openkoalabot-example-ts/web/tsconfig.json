{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "../src/core/wire.ts",
    "../src/core/webmedia.ts",
    "../src/ui/*.ts"
  ]
}
