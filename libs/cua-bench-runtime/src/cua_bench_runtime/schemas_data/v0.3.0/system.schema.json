{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cua.ai/cuabench/v0.3.0/system.schema.json",
  "title": "Cua-Bench Agent System Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "label",
    "configuration_class",
    "harness",
    "model_routing",
    "driver",
    "capability_inventory"
  ],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "label": { "type": "string", "minLength": 1 },
    "configuration_class": {
      "enum": ["vendor_default", "maintainer_default", "tuned"]
    },
    "harness": { "$ref": "#/$defs/harness" },
    "model_routing": { "$ref": "#/$defs/modelRouting" },
    "driver": { "$ref": "#/$defs/driver" },
    "capability_inventory": { "$ref": "#/$defs/capabilityInventory" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "build", "configuration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build": { "$ref": "#/$defs/artifact" },
        "configuration": { "$ref": "#/$defs/artifact" }
      }
    },
    "modelRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "provider", "model", "snapshot", "service_tier", "configuration_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["primary", "subagent", "fallback"] },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "service_tier": { "type": "string", "minLength": 1 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "undeclared_fallback_action"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modelRoute" }
        },
        "undeclared_fallback_action": { "const": "comparison_ineligible" }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "profile", "tool_contract_sha256", "skill_mode"],
      "properties": {
        "candidate": { "$ref": "#/$defs/versionedReference" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "$ref": "#/$defs/semver" }
          }
        },
        "tool_contract_sha256": { "$ref": "#/$defs/sha256" },
        "skill_mode": { "enum": ["bundled", "removed", "not_applicable"] }
      }
    },
    "capabilityInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "skills", "native_harness_capabilities_enabled"],
      "properties": {
        "tools": { "$ref": "#/$defs/artifact" },
        "skills": { "$ref": "#/$defs/artifact" },
        "native_harness_capabilities_enabled": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "model_routing": {
          "properties": {
            "routes": {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": { "role": { "const": "primary" } }
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      }
    }
  ]
}
