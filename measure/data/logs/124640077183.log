2026-10-31T19:08:50.2218809Z ##[group]Run set -eu
2026-10-31T19:08:50.2219095Z set -eu
2026-10-31T19:08:50.2219303Z fam="$SHARED"
2026-10-31T19:08:50.2219528Z if [ -z "$fam" ]; then
2026-10-31T19:08:50.2219977Z   first="$(printf '%s\n' "$WORKSPACES" | sed -n '/[^[:space:]]/{p;q;}' | sed 's/->.*//; s/[[:space:]]//g')"
2026-10-31T19:08:50.2220436Z   fam="${first:-root}"
2026-10-31T19:08:50.2220667Z fi
2026-10-31T19:08:50.2220963Z fam="$(printf '%s' "$fam" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)"
2026-10-31T19:08:50.2221420Z # Who saves. main saves on every OS (pushes, schedules and manual
2026-10-31T19:08:50.2221881Z # runs). A manual run on another branch saves too, into that branch's
2026-10-31T19:08:50.2222357Z # own scope: it is how a change to a workflow's cache is measured
2026-10-31T19:08:50.2222798Z # before it merges (run it twice and read the second run). Pull
2026-10-31T19:08:50.2223271Z # requests restore main's cache and save only when the pr-save input
2026-10-31T19:08:50.2223674Z # is "true", and then only on Linux.
2026-10-31T19:08:50.2223950Z save=false
2026-10-31T19:08:50.2224570Z if [ "$REF" = refs/heads/main ]; then save=true
2026-10-31T19:08:50.2224979Z elif [ "$EVENT" = workflow_dispatch ]; then save=true
2026-10-31T19:08:50.2225414Z elif [ "$PR_SAVE" = true ] && [ "$RUNNER_OS" = Linux ]; then save=true; fi
2026-10-31T19:08:50.2225821Z [ "$SAVE_IF" = false ] && save=false
2026-10-31T19:08:50.2226120Z dir="$RUNNER_TEMP/sccache"
2026-10-31T19:08:50.2226486Z # The prefix ends in "_", which the family never contains (it is
2026-10-31T19:08:50.2227142Z # reduced to letters, digits and "-"). With a "-" the family libs-cua
2026-10-31T19:08:50.2227632Z # was a prefix of libs-cua-build-fixtures, libs-cua-lint and the rest,
2026-10-31T19:08:50.2228083Z # and a run restored a sibling's entry instead of its own.
2026-10-31T19:08:50.2228490Z prefix="sccache-v2-$RUNNER_OS-$RUNNER_ARCH-${fam}_"
2026-10-31T19:08:50.2228925Z # One key per family per UTC day. A key with the commit sha was new on
2026-10-31T19:08:50.2229399Z # every push, so every main push saved a full copy of every family and
2026-10-31T19:08:50.2229856Z # the 50 GB budget turned over several times an hour. With the day in
2026-10-31T19:08:50.2230497Z # the key the first main run of the day saves, later runs that day see
2026-10-31T19:08:50.2230960Z # an exact hit and skip the save, and everything else restores the
2026-10-31T19:08:50.2231349Z # newest entry through the prefix.
2026-10-31T19:08:50.2231634Z bucket="$(date -u +%Y%m%d)"
2026-10-31T19:08:50.2231877Z {
2026-10-31T19:08:50.2232075Z   echo "family=$fam"
2026-10-31T19:08:50.2232315Z   echo "save=$save"
2026-10-31T19:08:50.2232540Z   echo "dir=$dir"
2026-10-31T19:08:50.2232772Z   echo "prefix=$prefix"
2026-10-31T19:08:50.2233025Z   echo "key=$prefix$bucket"
2026-10-31T19:08:50.2233279Z } >> "$GITHUB_OUTPUT"
2026-10-31T19:08:50.2233612Z echo "sccache plan: family=$fam key=$prefix$bucket save=$save"
