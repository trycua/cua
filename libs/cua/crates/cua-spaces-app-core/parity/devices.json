      "input": {
        "devices": [
          { "id": "dev_a", "name": "Studio", "state": "enrolled", "enrolledUntil": 1801000000, "lastSeen": 1799990000, "platform": "linux" }
        ],
        "enforceAfter": 1800432000
      }
    },
    {
      "step": "grace over",
