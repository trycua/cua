digraph g {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.3", ranksep="0.4"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f8fa", color="#57606a", fontcolor="#1f2328", fontname="Arial", fontsize=12, margin="0.15,0.1"];
  edge [color="#57606a", fontcolor="#1f2328", fontname="Arial", fontsize=10, arrowsize=0.7];
  action [label="macOS action tool"];
  global [label="diff all visible desktop windows"];
  json [label="write legacy JSON"];
  parse [label="parse shared action record"];
  confirm [label="promote effect to confirmed"];
  count [shape=diamond, label="new window count"];
  exact [label="emit exact rebind"];
  ambiguous [label="emit ambiguous rebind"];
  action -> global -> json -> parse -> confirm -> count;
  count -> exact [label="one"];
  count -> ambiguous [label="many"];
}
