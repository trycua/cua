    "SandboxIam.*",
    "Secret\\.iam_token",
    "SandboxIamTokenType"
   ],
   "status": "native-error",
   "tests": [
    "rust:rest_requires_the_key_and_answers_e2b_errors"
   ],
   "reason": "Workload identity tokens (SPIFFE JWT-SVIDs) are minted by E2B's identity service for E2B's own sandboxes; a Cua Space has no such issuer. create(iam=...) answers 400 naming the field."
  },
  {
   "id": "sbx-mcp",
   "section": "Sandbox lifecycle",
   "match": [
    "Sandbox\\.(get_mcp_token|get_mcp_url)",
    "McpServer.*",
    "McpServerName",
    "GitHubMcpServer.*",
    "Template(Base|Builder)?\\.add_mcp_server",
    "TemplateBuilder\\.add_mcp_server"
   ],
   "status": "native-error",
   "tests": [
    "rust:rest_requires_the_key_and_answers_e2b_errors"
   ],
   "reason": "E2B's MCP gateway is a hosted service that starts catalog MCP servers (Docker MCP catalog) behind an authenticated URL. A sandbox with mcp= answers 400; run an MCP server in the sandbox and reach it with get_host."
  },
  {
   "id": "git",
   "section": "Commands and processes",
   "match": [
    "Git(\\..*)?",
    "Git[A-Z]\\w*(\\..*)?",
    "Sandbox\\.git"
   ],
   "status": "implemented",
   "tests": [
    "sbx_git"
   ],
   "note": "The SDK's git helpers run git in the sandbox through commands.run."
  },
  {
   "id": "secrets",
   "section": "Platform: templates, secrets, volumes",
   "match": [
    "Secret\\.(create|update|get_info|exists|destroy|list|fill|__init__)",
    "SecretInfo.*",
    "Secret(Create|Update|Destroy|Exists|GetInfo|List)Opts.*",
    "SecretPaginator.*",
    "Secret"
   ],
   "status": "implemented",
   "tests": [
    "secrets_crud",
    "rust:secrets_are_named_versioned_and_write_only"
   ],
   "note": "Named, versioned, write-only secrets kept by the gateway. ${e2b.secrets.<name>} placeholders reach the sandbox as typed (no egress proxy resolves them)."
  },
  {
   "id": "templates",
   "section": "Platform: templates, secrets, volumes",
   "match": [
    "Template\\.(build|build_in_background|exists|alias_exists|get_build_status|get_tags|assign_tags|remove_tags|skip_cache|to_dockerfile|to_json|from_\\w+|__init__)",
    "Template",
    "TemplateBase.*",
    "TemplateBuilder.*",
    "TemplateClass",
    "TemplateBuildStatus.*",
    "TemplateTag.*",
    "BuildInfo.*",
    "BuildOptions",
    "BuildStatusReason.*",
    "GetBuildStatusOptions",
    "CopyItem.*",
    "LogEntry.*",
    "LogEntryEnd.*",
    "LogEntryStart.*",
    "LogEntryLevel",
    "ReadyCmd.*",
    "default_build_logger",
    "defaultBuildLogger",
    "wait_for_\\w+",
    "waitFor\\w+"
   ],
   "status": "implemented",
   "tests": [
    "tpl_build_use",
    "tpl_user_workdir",
    "tpl_build_failure",
    "tpl_build_bad_image",
    "tpl_names"
   ],
   "note": "RUN/COPY/ENV/WORKDIR/USER steps on the base Linux image (or another template), start and ready commands, tags, aliases; sandboxes fork the built checkpoint. Other OCI base images are refused with a build error."
  },
  {
   "id": "volumes",
   "section": "Platform: templates, secrets, volumes",
   "match": [
    "Volume.*",
    "AsyncVolume.*",
    "Volume"
   ],
   "status": "native-error",
   "reason": "E2B volumes (network file systems with their own data-plane host) are a separately enabled E2B team feature: the live service answers 403 'use of volumes is not enabled' to a team without it, which is what the gateway answers, so no recording of the data plane exists to match. Cua's equivalent, Cua Volume, is not mounted in QEMU VM Spaces today (the core gap that also refuses volume_mounts=, which answers 400); when VM Spaces mount it, Volume maps onto folders of it.",
   "tests": [
    "rust:volumes_answer_the_feature_not_enabled_error"
   ]
  },
  {
   "id": "errors",
   "section": "Errors",
   "match": [
    "\\w+(Exception|Error)",
    "\\w+(Exception|Error)\\.\\w+"
   ],
   "status": "implemented",
   "tests": [
    "cmd_exit_codes",
    "cmd_cwd",
    "files_read_errors",
    "sbx_kill_idempotent",
    "sbx_create_errors"
   ],
   "note": "Each exception class is raised for the same server answers: exit status/signal text, NotFound, InvalidArgument, Authentication, SandboxNotRunning/Unreachable, Timeout, Template/Build errors."
  },
  {
   "id": "routes",
   "section": "REST and envd routes",
   "match": [
    "route .*"
   ],
   "status": "implemented",
   "tests": [
    "sbx_create_info",
    "tpl_build_use",
    "secrets_crud"
   ],
   "note": "REST and envd routes the SDKs call. Routes without a public SDK method (team metrics, sandbox logs) answer E2B's JSON 404 or 400 and are listed under their SDK entries."
  }
 ]
}