[Unit]
Description=X display :1 (Xvfb or Xvnc) + XFCE session for the cua desktop user
After=systemd-tmpfiles-setup.service dbus.service
Wants=dbus.service

[Service]
Type=simple
User=cua
Environment=HOME=/home/cua XDG_RUNTIME_DIR=/run/cua-desktop
EnvironmentFile=-/etc/cua/desktop.env
ExecStart=/opt/cua/desktop/start-desktop.sh
Restart=always
RestartSec=2
KillMode=control-group
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
