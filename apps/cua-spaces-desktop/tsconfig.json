{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // The web sources this shell imports (../cua-spaces-web/src) resolve their
    // packages from this project's node_modules: the release build installs
    // only this project, not the web app. The bundler gets the same packages from tsdown.config.mts (tsconfig.build.json).
    "paths": { "*": ["./node_modules/*"] }
  },
  "include": ["src", "test", "tsdown.config.mts"]
}
