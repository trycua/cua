[
  "-name",
  "vm1",
  "-machine",
  "virt,memory-backend=mem0",
  "-cpu",
  "host",
  "-accel",
  "kvm",
  "-smp",
  "2",
  "-m",
  "2048",
  "-object",
  "memory-backend-ram,id=mem0,size=2048M",
  "-drive",
  "file=/s/vm1/disk.qcow2,if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap",
  "-device",
  "virtio-blk-pci,drive=disk0,bootindex=1",
  "-drive",
  "file=/s/vm1/seed.iso,if=none,id=cidata,format=raw,readonly=on",
  "-device",
  "virtio-blk-pci,drive=cidata",
  "-drive",
  "file=/install.iso,if=none,id=cd0,format=raw,readonly=on,media=cdrom",
  "-device",
  "virtio-scsi-pci,id=scsi0",
  "-device",
  "scsi-cd,drive=cd0,bootindex=0",
  "-netdev",
  "user,id=net0,hostfwd=tcp:127.0.0.1:40022-:22,hostfwd=tcp:127.0.0.1:40080-:8080",
  "-device",
  "virtio-net-pci,netdev=net0",
  "-device",
  "virtio-rng-pci",
  "-device",
  "virtio-gpu-pci",
  "-device",
  "qemu-xhci,id=xhci",
  "-device",
  "usb-kbd",
  "-device",
  "usb-tablet",
  "-display",
  "none",
  "-vnc",
  "127.0.0.1:3",
  "-qmp",
  "tcp:127.0.0.1:4444,server=on,wait=off",
  "-serial",
  "file:/s/vm1/serial.log",
  "-monitor",
  "none",
  "-pidfile",
  "/s/vm1/qemu.pid",
  "-daemonize"
]