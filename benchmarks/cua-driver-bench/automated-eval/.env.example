# Optional model provider settings read by the local runner. Do not commit values.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional S3 report publishing. Used only by `cli.py publish` and `--publish`.
# Leave AWS_S3_BUCKET empty to keep reports local.
AWS_PROFILE=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_REPORT_PREFIX=cua-driver-bench
