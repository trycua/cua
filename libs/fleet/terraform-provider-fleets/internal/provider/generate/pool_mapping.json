{
  "resource_description": "A Cua Fleet computer-use pool: an OSGymSandboxWarmPool and its OSGymSandboxTemplate. The pool name also owns its same-named namespace.",
  "attributes": [
    {
      "name": "id",
      "go_name": "ID",
      "value_type": "string",
      "mode": "computed"
    },
    {
      "name": "name",
      "go_name": "Name",
      "value_type": "string",
      "mode": "required",
      "description": "DNS label used for both pool and namespace.",
      "dns_label": true,
      "requires_replace": true
    },
    {
      "name": "namespace",
      "go_name": "Namespace",
      "value_type": "string",
      "mode": "computed"
    },
    {
      "name": "replicas",
      "go_name": "Replicas",
      "value_type": "int64",
      "mode": "required",
      "cr": "warmpool",
      "crd_path": "spec.replicas"
    },
    {
      "name": "cpu_cores",
      "go_name": "CPUCores",
      "value_type": "int64",
      "mode": "required",
      "cr": "template",
      "crd_path": "spec.vmTemplate.cpuCores"
    },
    {
      "name": "memory",
      "go_name": "Memory",
      "value_type": "string",
      "mode": "required",
      "cr": "template",
      "crd_path": "spec.vmTemplate.memory"
    },
    {
      "name": "container_disk_image",
      "go_name": "ContainerDiskImage",
      "value_type": "string",
      "mode": "required",
      "cr": "template",
      "crd_path": "spec.vmTemplate.containerDiskImage"
    },
    {
      "name": "image_pull_secret",
      "go_name": "ImagePullSecret",
      "value_type": "string",
      "mode": "optional_computed",
      "cr": "template",
      "crd_path": "spec.vmTemplate.imagePullSecret",
      "description": "Kubernetes image pull secret. Defaults to ecr-credentials."
    },
    {
      "name": "runtime",
      "go_name": "Runtime",
      "value_type": "string",
      "mode": "optional_computed",
      "cr": "template",
      "crd_path": "spec.vmTemplate.runtime"
    },
    {
      "name": "firmware",
      "go_name": "Firmware",
      "value_type": "string",
      "mode": "optional_computed",
      "cr": "template",
      "crd_path": "spec.vmTemplate.firmware"
    },
    {
      "name": "readiness_probe_json",
      "go_name": "ReadinessProbeJSON",
      "value_type": "normalized_json",
      "mode": "optional",
      "cr": "template",
      "crd_path": "spec.vmTemplate.probes",
      "description": "JSON object for the VMI readinessProbe."
    },
    {
      "name": "liveness_probe_json",
      "go_name": "LivenessProbeJSON",
      "value_type": "normalized_json",
      "mode": "optional",
      "cr": "template",
      "crd_path": "spec.vmTemplate.probes",
      "description": "JSON object for the VMI livenessProbe."
    },
    {
      "name": "template_name",
      "go_name": "TemplateName",
      "value_type": "string",
      "mode": "computed",
      "cr": "warmpool",
      "crd_path": "spec.sandboxTemplateRef.name",
      "description": "Name of the OSGymSandboxTemplate backing this pool."
    },
    {
      "name": "current_replicas",
      "go_name": "CurrentReplicas",
      "value_type": "int64",
      "mode": "computed",
      "cr": "warmpool",
      "crd_path": "status.replicas",
      "description": "Sandboxes the warm pool currently owns."
    },
    {
      "name": "ready_replicas",
      "go_name": "ReadyReplicas",
      "value_type": "int64",
      "mode": "computed",
      "cr": "warmpool",
      "crd_path": "status.readyReplicas",
      "description": "Sandboxes that are ready to be claimed."
    }
  ],
  "blocks": [
    {
      "name": "service",
      "model": "serviceModel",
      "collection": "set",
      "cr": "template",
      "crd_path": "spec.vmTemplate.services",
      "fields": [
        {
          "name": "name",
          "go_name": "Name",
          "value_type": "string",
          "mode": "required",
          "crd_path": "name"
        },
        {
          "name": "target_port",
          "go_name": "TargetPort",
          "value_type": "int64",
          "mode": "required",
          "crd_path": "targetPort"
        },
        {
          "name": "protocol",
          "go_name": "Protocol",
          "value_type": "string",
          "mode": "optional_computed",
          "crd_path": "protocol"
        }
      ],
      "go_name": "Services"
    },
    {
      "name": "autoscaling",
      "model": "autoscalingModel",
      "collection": "single",
      "cr": "warmpool",
      "crd_path": "spec.autoscaling",
      "fields": [
        {
          "name": "min_pool_size",
          "go_name": "MinPoolSize",
          "value_type": "int64",
          "mode": "optional_computed",
          "crd_path": "minPoolSize"
        },
        {
          "name": "initial_pool_size",
          "go_name": "InitialPoolSize",
          "value_type": "int64",
          "mode": "optional_computed",
          "crd_path": "initialPoolSize"
        },
        {
          "name": "max_pool_size",
          "go_name": "MaxPoolSize",
          "value_type": "int64",
          "mode": "required",
          "crd_path": "maxPoolSize"
        }
      ],
      "go_name": "Autoscaling"
    }
  ]
}
