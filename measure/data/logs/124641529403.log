2026-10-31T19:57:25.7541429Z set -eu
2026-10-31T19:57:25.7541636Z fam="$SHARED"
2026-10-31T19:57:25.7541861Z if [ -z "$fam" ]; then
2026-10-31T19:57:25.7542308Z   first="$(printf '%s\n' "$WORKSPACES" | sed -n '/[^[:space:]]/{p;q;}' | sed 's/->.*//; s/[[:space:]]//g')"
2026-10-31T19:57:25.7542768Z   fam="${first:-root}"
2026-10-31T19:57:25.7543001Z fi
2026-10-31T19:57:25.7543293Z fam="$(printf '%s' "$fam" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)"
2026-10-31T19:57:25.7543755Z # Who saves. main saves on every OS (pushes, schedules and manual
2026-10-31T19:57:25.7544221Z # runs). A manual run on another branch saves too, into that branch's
2026-10-31T19:57:25.7544691Z # own scope: it is how a change to a workflow's cache is measured
2026-10-31T19:57:25.7545134Z # before it merges (run it twice and read the second run). Pull
2026-10-31T19:57:25.7545612Z # requests restore main's cache and save only when the pr-save input
2026-10-31T19:57:25.7546012Z # is "true", and then only on Linux.
2026-10-31T19:57:25.7546530Z save=false
2026-10-31T19:57:25.7546799Z if [ "$REF" = refs/heads/main ]; then save=true
2026-10-31T19:57:25.7547178Z elif [ "$EVENT" = workflow_dispatch ]; then save=true
2026-10-31T19:57:25.7547623Z elif [ "$PR_SAVE" = true ] && [ "$RUNNER_OS" = Linux ]; then save=true; fi
2026-10-31T19:57:25.7548023Z [ "$SAVE_IF" = false ] && save=false
2026-10-31T19:57:25.7548309Z dir="$RUNNER_TEMP/sccache"
2026-10-31T19:57:25.7548658Z # The prefix ends in "_", which the family never contains (it is
2026-10-31T19:57:25.7549293Z # reduced to letters, digits and "-"). With a "-" the family libs-cua
2026-10-31T19:57:25.7549785Z # was a prefix of libs-cua-build-fixtures, libs-cua-lint and the rest,
2026-10-31T19:57:25.7550240Z # and a run restored a sibling's entry instead of its own.
2026-10-31T19:57:25.7550648Z prefix="sccache-v2-$RUNNER_OS-$RUNNER_ARCH-${fam}_"
2026-10-31T19:57:25.7551084Z # One key per family per UTC day. A key with the commit sha was new on
2026-10-31T19:57:25.7551561Z # every push, so every main push saved a full copy of every family and
2026-10-31T19:57:25.7552027Z # the 50 GB budget turned over several times an hour. With the day in
2026-10-31T19:57:25.7552644Z # the key the first main run of the day saves, later runs that day see
2026-10-31T19:57:25.7553112Z # an exact hit and skip the save, and everything else restores the
2026-10-31T19:57:25.7553496Z # newest entry through the prefix.
2026-10-31T19:57:25.7553790Z bucket="$(date -u +%Y%m%d)"
2026-10-31T19:57:25.7554040Z {
2026-10-31T19:57:25.7554245Z   echo "family=$fam"
2026-10-31T19:57:25.7554484Z   echo "save=$save"
2026-10-31T19:57:25.7554719Z   echo "dir=$dir"
2026-10-31T19:57:25.7554956Z   echo "prefix=$prefix"
2026-10-31T19:57:25.7555214Z   echo "key=$prefix$bucket"
2026-10-31T19:57:25.7555473Z } >> "$GITHUB_OUTPUT"
2026-10-31T19:57:25.7555805Z echo "sccache plan: family=$fam key=$prefix$bucket save=$save"
