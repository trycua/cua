[
  "-name", "vm1",
  "-machine", "virt",
  "-cpu", "host",
  "-accel", "hvf",
  "-smp", "2",
  "-m", "2048",
  "-drive", "file=/s/vm1/disk.qcow2,if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap",
  "-device", "nvme,drive=disk0,serial=cua-disk0,bootindex=1",
  "-device", "qemu-xhci,id=xhci",
  "-drive", "file=/install.iso,if=none,id=cd0,format=raw,readonly=on,media=cdrom",
  "-device", "usb-storage,drive=cd0,bus=xhci.0,bootindex=0",
  "-netdev", "user,id=net0,hostfwd=tcp:127.0.0.1:40022-:22,hostfwd=tcp:127.0.0.1:40080-:8080",
  "-device", "virtio-net-pci,netdev=net0",
  "-device", "ramfb",
  "-device", "usb-kbd",
  "-device", "usb-tablet",
  "-display", "none",
  "-vnc", "127.0.0.1:3",
  "-qmp", "tcp:127.0.0.1:4444,server=on,wait=off",
  "-serial", "file:/s/vm1/serial.log",
  "-monitor", "none",
  "-pidfile", "/s/vm1/qemu.pid",
  "-daemonize"
]
