[Unit]
Description=Headless PipeWire (pipewire + wireplumber + pipewire-pulse) for the cua desktop user
After=systemd-tmpfiles-setup.service cua-desktop.service
Wants=cua-desktop.service

[Service]
Type=simple
User=cua
Environment=HOME=/home/cua XDG_RUNTIME_DIR=/run/cua-desktop
ExecStart=/opt/cua/bin/start-audio.sh
Restart=always
RestartSec=2
KillMode=control-group
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
