{
  "name": "drive-onboarding",
  "about": "The first run's Cua Volume page (with the Cua Volume experiment on): its miniature (the volume mounting in a Finder sidebar, three files flying over from a Space), then the page on a Mac (off by default, ticked, mounting, waiting for the extension's approval, Done), on Linux (a mount), with no daemon answer (an honest disabled line), on Windows (no page), and the three places files can live: this Mac (nothing to set up), your S3 bucket (filled in, a failed test, a passing one, saved, then mounted) and set up later; the bucket path starts from the agent prompt (fields on request), and a bucket the agent connects is noticed and adopted.",
  "times": [
    0,
    400,
    900,
    1200,
    1700,
    2400,
    3000,
    4400,
    4799
  ],
  "runs": [
    {
      "name": "mac",
      "steps": [
        {
          "action": {
            "type": "experiments-loaded",
            "experiments": {
              "cuaVolume": true
            }
          }
        },
        {
          "action": {
            "type": "start"
          }
        },
        {
          "action": {
            "type": "signin-done"
          }
        },
        {
          "action": {
            "type": "agents-done",
            "configured": []
          }
        },
        {
          "action": {
            "type": "drive-storage-loaded",
            "storage": {
              "backend": "fs",
              "fs_path": "/Users/maya/.cua/volume/data",
              "s3": null,
              "has_keys": false
            },
            "home": "/Users/maya"
          }
        },
        {
          "step": "checking",
          "action": {
            "type": "presentation-done"
          }
        },
        {
          "step": "off by default",
          "action": {
            "type": "drive-checked",
            "os": "macos",
            "status": {
              "enabled": false,
              "state": "off",
              "method": "fskit",
              "path": null,
              "volume_name": "Cua Volume"
            }
          }
        },
        {
          "step": "ticked",
          "action": {
            "type": "drive-toggled",
            "on": true
          }
        },
        {
          "step": "mounting",
          "action": {
            "type": "drive-continue"
          }
        },
        {
          "step": "needs approval",
          "action": {
            "type": "drive-mounted",
            "status": {
              "enabled": true,
              "state": "needs_approval",
              "method": "fskit",
              "path": null,
              "volume_name": "Cua Volume",
              "detail": "Turn on Cua Volume in File System Extensions.",
              "settings_url": "x-apple.systempreferences:com.apple.LoginItems-Settings.extension"
            }
          }
        },
        {
          "step": "continue",
          "action": {
            "type": "drive-continue"
          }
        },
        {
          "step": "done",
          "action": {
            "type": "mode-chosen",
            "mode": "client"
          }
        }
      ]
    },
