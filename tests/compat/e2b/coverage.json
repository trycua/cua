  {
   "id": "sbx-proxy",
   "section": "Network and URLs",
   "match": [
    "SandboxNetworkRule.*",
    "SandboxNetworkRules",
    "SandboxNetworkTransform.*",
    "SandboxNetworkTransformContext.*",
    "SandboxNetworkTransformResolver",
    "SandboxEgressProxy.*",
    "SandboxEgressProxyTLS.*"
   ],
   "status": "native-error",
   "tests": [
    "rust:rest_requires_the_key_and_answers_e2b_errors"
   ],
   "reason": "Rewriting outbound requests (header transforms, egress proxies, host masking, HTTPS interception) needs a traffic-inspecting proxy in the data path. Cua Spaces have none, and a fake would silently skip the transform. The gateway answers 400 naming the field."
  },
