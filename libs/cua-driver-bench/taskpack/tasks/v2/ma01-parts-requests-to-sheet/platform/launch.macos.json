{
  "platform": "macos",
  "descriptor_version": "1",
  "semantics": {
    "task_id": "cua.v2.ma01-parts-requests-to-sheet",
    "task_version": "1.0.0",
    "brief": "brief.md",
    "reset": {
      "setup": [
        "${python}",
        "reset/setup.py",
        "--workspace",
        "${workspace}"
      ],
      "verify": [
        "${python}",
        "reset/verify.py",
        "--workspace",
        "${workspace}"
      ]
    },
    "evaluate": [
      "${python}",
      "evaluator/evaluate.py",
      "--workspace",
      "${workspace}",
      "--artifacts",
      "${artifacts}",
      "--result",
      "${result}",
      "--agent-exit-code",
      "${agent_exit_code}"
    ],
    "required_apps": [
      "Google Chrome",
      "LibreOffice Calc"
    ]
  },
  "workspace_root": "${HOME}/v2-ma01",
  "apps": [
    {
      "id": "site",
      "kind": "service",
      "role": "the task's local web app (loopback only)",
      "command": [
        "${python}",
        "${bundle}/../_kit/v2kit/serve.py",
        "--app",
        "${bundle}/app",
        "--state-dir",
        "${workspace}/state",
        "--port",
        "4501",
        "--initial",
        "${bundle}/app/initial-state.json"
      ],
      "ready": {
        "http": "http://127.0.0.1:4501/healthz",
        "timeout_seconds": 15
      }
    },
    {
      "id": "browser",
      "kind": "browser",
      "role": "Google Chrome on the task's local page",
      "command": [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-default-apps",
        "--disable-sync",
        "--disable-features=Translate,PasswordManagerOnboarding,AutofillServerCommunication",
        "--user-data-dir=${workspace}/.runtime/chrome",
        "--new-window",
        "http://127.0.0.1:4501/"
      ],
      "window": {
        "title_contains": "Wrenfield Makerspace Requests",
        "bounds": {
          "x": 20,
          "y": 40,
          "width": 1240,
          "height": 900
        }
      }
    },
    {
      "id": "office",
      "kind": "office",
      "role": "LibreOffice Calc on the purchase log",
      "command": [
        "/Applications/LibreOffice.app/Contents/MacOS/soffice",
        "--calc",
        "--norestore",
        "--nodefault",
        "--nolockcheck",
        "-env:UserInstallation=${workspace_uri}/.runtime/libreoffice",
        "${workspace}/purchase-log.fods"
      ],
      "process_names": [
        "soffice",
        "soffice.bin"
      ],
      "window": {
        "title_contains": "purchase-log.fods",
        "bounds": {
          "x": 1000,
          "y": 120,
          "width": 900,
          "height": 900
        }
      }
    }
  ]
}
