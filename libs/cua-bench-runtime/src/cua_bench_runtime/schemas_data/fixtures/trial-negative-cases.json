{
  "schema": "trial.schema.json",
  "base": "../examples/trial.native-bundle.cuabench.json",
  "cases": [
    { "name": "root-fields", "remove": ["/schema_version", "/id", "/task", "/dataset", "/variant", "/profile", "/pairing_key", "/attempt_index", "/model", "/provider", "/harness", "/environment", "/support_status", "/missing_capabilities", "/eligibility_status", "/eligibility_evidence", "/pre_freeze", "/truncated"], "covers": "#/required", "expect": { "instance": "/", "validator": "required" } },
    { "name": "versioned-reference-fields", "remove": ["/task/id", "/task/version", "/task/manifest_sha256"], "covers": "#/$defs/versionedReference/required", "expect": { "instance": "/task", "validator": "required" } },
    { "name": "dataset-reference-fields", "remove": ["/dataset/id", "/dataset/version", "/dataset/manifest_sha256"], "covers": "#/$defs/datasetReference/required", "expect": { "instance": "/dataset", "validator": "required" } },
    { "name": "profile-reference-fields", "remove": ["/profile/id", "/profile/version"], "covers": "#/$defs/profileReference/required", "expect": { "instance": "/profile", "validator": "required" } },
    { "name": "resolved-component-fields", "remove": ["/model/id", "/model/version"], "covers": "#/$defs/resolvedComponent/required", "expect": { "instance": "/model", "validator": "required" } },
    { "name": "harness-fields", "remove": ["/harness/build_id", "/harness/version", "/harness/build", "/harness/inventory"], "covers": "#/$defs/resolvedHarness/required", "expect": { "instance": "/harness", "validator": "required" } },
    { "name": "environment-fields", "remove": ["/environment/id", "/environment/os", "/environment/os_version", "/environment/architecture", "/environment/image", "/environment/observer"], "covers": "#/$defs/environment/required", "expect": { "instance": "/environment", "validator": "required" } },
    { "name": "bindings-fields", "remove": ["/bindings/dataset_freeze_digest", "/bindings/apparatus_digest"], "covers": "#/$defs/bindings/required", "expect": { "instance": "/bindings", "validator": "required" } },
    { "name": "artifact-fields", "remove": ["/harness/inventory/path", "/harness/inventory/sha256"], "covers": "#/$defs/artifact/required", "expect": { "instance": "/harness/inventory", "validator": "required" } },
    { "name": "delivery-status", "remove": ["/resolved_driver/skill_delivery/status"], "covers": "#/$defs/delivery/required", "expect": { "instance": "/resolved_driver/skill_delivery", "validator": "required" } },
    { "name": "delivered-fields", "remove": ["/resolved_driver/skill_delivery/channel", "/resolved_driver/skill_delivery/injection_point", "/resolved_driver/skill_delivery/bytes", "/resolved_driver/skill_delivery/token_count", "/resolved_driver/skill_delivery/content_sha256", "/resolved_driver/skill_delivery/source_artifact", "/resolved_driver/skill_delivery/content_artifact"], "covers": "#/$defs/delivery/allOf/0/then/required", "expect": { "instance": "/resolved_driver/skill_delivery", "validator": "required" } },
    { "name": "not-delivered-reason", "base": "../examples/trial.bare-driver.cuabench.json", "remove": ["/resolved_driver/skill_delivery/reason"], "covers": "#/$defs/delivery/allOf/0/else/required", "expect": { "instance": "/resolved_driver/skill_delivery", "validator": "required" } },
    { "name": "resolved-driver-fields", "remove": ["/resolved_driver/tool_schemas_digest", "/resolved_driver/tool_names", "/resolved_driver/skill_delivery"], "covers": "#/$defs/resolvedDriver/required", "expect": { "instance": "/resolved_driver", "validator": "required" } },
    { "name": "execution-fields", "remove": ["/execution/agent_execution_id", "/execution/started_at", "/execution/ended_at", "/execution/event_log"], "covers": "#/$defs/execution/required", "expect": { "instance": "/execution", "validator": "required" } },
    { "name": "finding-fields", "replace": { "/outcomes/forbidden_side_effects": [{ "target": "decoy", "description": "changed" }] }, "remove": ["/outcomes/forbidden_side_effects/0/target", "/outcomes/forbidden_side_effects/0/description"], "covers": "#/$defs/finding/required", "expect": { "instance": "/outcomes/forbidden_side_effects/0", "validator": "required" } },
    { "name": "outcome-fields", "remove": ["/outcomes/completion", "/outcomes/forbidden_side_effects", "/outcomes/wrong_target_mutations", "/outcomes/leaked_input"], "covers": "#/$defs/outcomes/required", "expect": { "instance": "/outcomes", "validator": "required" } },
    { "name": "token-fields", "remove": ["/observables/tokens/input", "/observables/tokens/output", "/observables/tokens/tool_schema", "/observables/tokens/driver_skill", "/observables/tokens/neutral_guidance"], "covers": "#/$defs/tokenUsage/required", "expect": { "instance": "/observables/tokens", "validator": "required" } },
    { "name": "tool-use-fields", "remove": ["/observables/tool_usage/0/name", "/observables/tool_usage/0/calls"], "covers": "#/$defs/toolUse/required", "expect": { "instance": "/observables/tool_usage/0", "validator": "required" } },
    { "name": "observable-fields", "remove": ["/observables/focus_changes", "/observables/focus_recovery", "/observables/cursor_movement", "/observables/surface_transitions", "/observables/wall_time_ms", "/observables/cost_usd", "/observables/tokens", "/observables/tool_usage"], "covers": "#/$defs/observables/required", "expect": { "instance": "/observables", "validator": "required" } },
    { "name": "eligible-fields", "remove": ["/execution", "/termination_status", "/outcomes", "/observables", "/evidence"], "covers": "#/allOf/2/then/required", "expect": { "instance": "/", "validator": "required" } },
    { "name": "candidate-driver-fields", "remove": ["/candidate", "/resolved_driver"], "covers": "#/allOf/3/else/required", "expect": { "instance": "/", "validator": "required" } },
    { "name": "normalized-neutral-delivery", "base": "../examples/trial.normalized-facade.cuabench.json", "remove": ["/resolved_driver/neutral_guidance_delivery"], "covers": "#/allOf/6/then/properties/resolved_driver/required", "expect": { "instance": "/resolved_driver", "validator": "required" } },
    { "name": "unknown-missing-capability", "replace": { "/support_status": "unsupported", "/missing_capabilities": ["vendor.magic-click"] }, "expect": { "instance": "/missing_capabilities/0", "validator": "enum" } },
    { "name": "ineligible-execution", "base": "../examples/trial.ineligible.cuabench.json", "replace": { "/execution": { "agent_execution_id": "invalid", "started_at": "2026-08-15T16:00:00Z", "ended_at": "2026-08-15T16:00:01Z", "event_log": { "path": "freeze-inputs/event-log.jsonl", "sha256": "3900b0674aca1abfea11fa53aeddc3d0521772b98d6ad9d9d5eb62c9eb0092fd" } } }, "expect": { "instance": "/", "validator": "not" } },
    { "name": "post-freeze-without-bindings", "remove": ["/bindings"], "covers": "#/allOf/1/then/required", "expect": { "instance": "/", "validator": "required" } },
    { "name": "post-freeze-without-dataset-digest", "remove": ["/dataset/freeze_digest"], "covers": "#/allOf/1/then/properties/dataset/required", "expect": { "instance": "/dataset", "validator": "required" } },
    { "name": "pre-freeze-with-bindings", "replace": { "/pre_freeze": true }, "expect": { "instance": "/", "validator": "not" } },
    { "name": "pre-freeze-with-dataset-digest", "base": "../examples/trial.ineligible.cuabench.json", "replace": { "/dataset/freeze_digest": "bb0cdefaa74107d64526087c1432cd4c0618791cba933664dc55e92f7696e413" }, "expect": { "instance": "/dataset", "validator": "not" } },
    { "name": "supported-with-missing-capability", "replace": { "/missing_capabilities": ["keyboard.text-entry"] }, "expect": { "instance": "/missing_capabilities", "validator": "maxItems" } },
    { "name": "unsupported-without-missing-capability", "replace": { "/support_status": "unsupported" }, "expect": { "instance": "/missing_capabilities", "validator": "minItems" } },
    { "name": "ineligible-truncated", "base": "../examples/trial.ineligible.cuabench.json", "replace": { "/truncated": true }, "expect": { "instance": "/truncated", "validator": "const" } },
    { "name": "reference-with-candidate", "base": "../examples/trial.harness-native-reference.cuabench.json", "replace": { "/candidate": { "id": "cua.synthetic.driver", "version": "1.0.0", "manifest_sha256": "6bac21e334ef593c0897506ce84338db9d5869044151bc02b8734165abe40b44" } }, "expect": { "instance": "/", "validator": "not" } },
    { "name": "native-neutral-guidance", "replace": { "/resolved_driver/neutral_guidance_delivery": { "status": "not-delivered", "reason": "not used" } }, "expect": { "instance": "/resolved_driver", "validator": "not" } },
    { "name": "bare-delivered-skill", "base": "../examples/trial.bare-driver.cuabench.json", "replace": { "/resolved_driver/skill_delivery/status": "delivered" }, "expect": { "instance": "/resolved_driver/skill_delivery/status", "validator": "enum" } },
    { "name": "normalized-delivered-skill", "base": "../examples/trial.normalized-facade.cuabench.json", "replace": { "/resolved_driver/skill_delivery/status": "delivered" }, "expect": { "instance": "/resolved_driver/skill_delivery/status", "validator": "enum" } },
    { "name": "normalized-neutral-not-delivered", "base": "../examples/trial.normalized-facade.cuabench.json", "replace": { "/resolved_driver/neutral_guidance_delivery/status": "not-delivered" }, "expect": { "instance": "/resolved_driver/neutral_guidance_delivery/status", "validator": "const" } },
    { "name": "invalid-start-timestamp", "replace": { "/execution/started_at": "2026-99-99" }, "expect": { "instance": "/execution/started_at", "validator": "format" } }
  ]
}
