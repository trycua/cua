{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The MCP client configuration shape the docs show (Claude, Cursor, VS Code and similar): named servers, each a stdio command or a remote URL.",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "mcpServers": { "$ref": "#/$defs/servers" },
    "servers": { "$ref": "#/$defs/servers" }
  },
  "anyOf": [{ "required": ["mcpServers"] }, { "required": ["servers"] }],
  "$defs": {
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "anyOf": [{ "required": ["command"] }, { "required": ["url"] }],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "url": { "type": "string", "minLength": 1 },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "type": { "type": "string" }
        }
      }
    }
  }
}
