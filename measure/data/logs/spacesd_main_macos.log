2026-10-31T02:30:22.9453130Z   Windows-X64 | Windows-ARM64) asset="win64" ;;
2026-10-31T02:30:22.9453790Z   Windows-X86)  asset="win32" ;;
2026-10-31T02:30:22.9454770Z   *) echo "::error::No protoc build for ${RUNNER_OS_NAME}-${RUNNER_ARCH_NAME}"; exit 1 ;;
2026-10-31T02:30:22.9455680Z esac
2026-10-31T02:30:22.9456190Z dir="${HOME}/.protoc/${VERSION}-${asset}"
2026-10-31T02:30:22.9457130Z # Native path on Windows so actions/cache and cargo build scripts agree.
2026-10-31T02:30:22.9458290Z if command -v cygpath >/dev/null 2>&1; then dir="$(cygpath -m "$dir")"; fi
2026-10-31T02:30:22.9459380Z echo "asset=protoc-${VERSION}-${asset}.zip" >> "$GITHUB_OUTPUT"
2026-10-31T02:30:22.9460230Z echo "dir=${dir}" >> "$GITHUB_OUTPUT"
2026-10-31T02:30:22.9461720Z # The runner architecture is in the key: Windows x64 and Arm runners
2026-10-31T02:30:22.9462880Z # both use the win64 build but keep their workspace on different
2026-10-31T02:30:22.9463910Z # drives, and a cache saved on one restores to the wrong drive on the
2026-10-31T02:30:22.9464890Z # other (protoc then "No such file or directory").
2026-10-31T02:30:22.9465840Z echo "key=protoc-${VERSION}-${asset}-${RUNNER_ARCH_NAME}" >> "$GITHUB_OUTPUT"
