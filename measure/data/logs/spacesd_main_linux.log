2026-10-31T02:31:16.9329264Z ##[group]Run set -eu
2026-10-31T02:31:16.9329643Z set -eu
2026-10-31T02:31:16.9329939Z fam="$SHARED"
2026-10-31T02:31:16.9330243Z if [ -z "$fam" ]; then
2026-10-31T02:31:16.9330671Z   first="$(printf '%s\n' "$WORKSPACES" | sed -n '/[^[:space:]]/{p;q;}' | sed 's/->.*//; s/[[:space:]]//g')"
2026-10-31T02:31:16.9331106Z   fam="${first:-root}"
2026-10-31T02:31:16.9331479Z fi
2026-10-31T02:31:16.9331877Z fam="$(printf '%s' "$fam" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)"
2026-10-31T02:31:16.9332307Z # Who saves. main saves on every OS (pushes, schedules and manual
2026-10-31T02:31:16.9332940Z # runs). A manual run on another branch saves too, into that branch's
2026-10-31T02:31:16.9333363Z # own scope: it is how a change to a workflow's cache is measured
2026-10-31T02:31:16.9333860Z # before it merges (run it twice and read the second run). Pull
2026-10-31T02:31:16.9334430Z # requests restore main's cache and save only when the pr-save input
2026-10-31T02:31:16.9334811Z # is "true", and then only on Linux.
2026-10-31T02:31:16.9335079Z save=false
2026-10-31T02:31:16.9335449Z if [ "$REF" = refs/heads/main ]; then save=true
2026-10-31T02:31:16.9335938Z elif [ "$EVENT" = workflow_dispatch ]; then save=true
2026-10-31T02:31:16.9336344Z elif [ "$PR_SAVE" = true ] && [ "$RUNNER_OS" = Linux ]; then save=true; fi
2026-10-31T02:31:16.9336707Z [ "$SAVE_IF" = false ] && save=false
2026-10-31T02:31:16.9336985Z dir="$RUNNER_TEMP/sccache"
2026-10-31T02:31:16.9337323Z # The prefix ends in "_", which the family never contains (it is
2026-10-31T02:31:16.9337817Z # reduced to letters, digits and "-"). With a "-" the family libs-cua
2026-10-31T02:31:16.9338417Z # was a prefix of libs-cua-build-fixtures, libs-cua-lint and the rest,
2026-10-31T02:31:16.9338838Z # and a run restored a sibling's entry instead of its own.
2026-10-31T02:31:16.9339364Z prefix="sccache-v2-$RUNNER_OS-$RUNNER_ARCH-${fam}_"
2026-10-31T02:31:16.9339918Z # One key per family per UTC day. A key with the commit sha was new on
2026-10-31T02:31:16.9340356Z # every push, so every main push saved a full copy of every family and
2026-10-31T02:31:16.9340946Z # the 50 GB budget turned over several times an hour. With the day in
2026-10-31T02:31:16.9341374Z # the key the first main run of the day saves, later runs that day see
2026-10-31T02:31:16.9341962Z # an exact hit and skip the save, and everything else restores the
2026-10-31T02:31:16.9342728Z # newest entry through the prefix.
2026-10-31T02:31:16.9343113Z bucket="$(date -u +%Y%m%d)"
2026-10-31T02:31:16.9343482Z {
2026-10-31T02:31:16.9343745Z   echo "family=$fam"
2026-10-31T02:31:16.9343989Z   echo "save=$save"
2026-10-31T02:31:16.9344226Z   echo "dir=$dir"
2026-10-31T02:31:16.9344885Z   echo "prefix=$prefix"
2026-10-31T02:31:16.9345145Z   echo "key=$prefix$bucket"
2026-10-31T02:31:16.9345402Z } >> "$GITHUB_OUTPUT"
2026-10-31T02:31:16.9345837Z echo "sccache plan: family=$fam key=$prefix$bucket save=$save"
2026-10-31T02:31:16.9359755Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
