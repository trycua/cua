        },
        {
          "action": {
            "type": "drive-storage",
            "action": {
              "type": "set-field",
              "field": "access-key-id",
              "value": "maya-drive"
            }
          }
        },
        {
          "step": "filled in",
          "action": {
            "type": "drive-storage",
            "action": {
              "type": "set-field",
              "field": "secret-access-key",
              "value": "fixture-secret"
            }
          }
        },
