{
  "schema_version": 1,
  "name": "agent-home",
  "description": "The lightest home for a coding agent: the slim Linux image (cua-spacesd, desktop, Chromium) plus the cua CLI, so an agent in a Space can create, use and delete child Spaces. The network conformance suite runs its children case in it. Container rootfs for docker, gVisor and microVMs, and a VM disk for QEMU and KubeVirt.",
  "repository": "ghcr.io/trycua/agent-home",
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "outputs": {
    "rootfs": {
      "tag_prefix": "docker-",
      "runtimes": [
        "docker",
        "gvisor"
      ],
      "init": "supervisord"
    },
    "containerdisk": {
      "tag_prefix": "",
      "runtimes": [
        "kubevirt",
        "qemu"
      ],
      "init": "systemd",
      "path": "/disk/disk.img",
      "firmware": {
        "amd64": [
          "bios",
          "efi"
        ],
        "arm64": [
          "efi"
        ]
      }
    }
  },
  "desktop": {
    "display": ":1",
    "resolution": "1280x800",
    "user": "cua",
    "uid": 1000,
    "runtime_dir": "/run/cua-desktop",
    "session_bus": "unix:path=/run/cua-desktop/bus"
  },
  "services": [
    {
      "name": "env",
      "port": 3211,
      "protocol": "grpc",
      "component": "cua-spacesd",
      "auth": "bearer token: CUA_ENV_TOKEN or /run/cua/env-token",
      "readiness": "tcp"
    },
    {
      "name": "viewer",
      "port": 3211,
      "protocol": "http",
      "component": "cua-spacesd",
      "readiness": "http:/viewer/"
    },
    {
      "name": "env-media",
      "port": 3212,
      "protocol": "udp",
      "component": "cua-spacesd"
    },
    {
      "name": "ssh",
      "port": 22,
      "protocol": "tcp",
      "variants": [
        "containerdisk"
      ]
    }
  ],
  "audio": {
    "server": "pipewire + wireplumber + pipewire-pulse",
    "runtime_dir": "/run/cua-desktop",
    "default_sink": "cua_desktop",
    "desktop_capture": "cua_desktop.monitor",
    "default_source": "cua_mic",
    "uplink_input_sink": "cua_mic_in",
    "format": "48000 Hz stereo"
  },
  "claims": {
    "_doc": "What the image promises; cua-image-manifest turns this into /etc/cua-image/manifest.json and cua-spacesd doctor checks it (claimed = required).",
    "features_required": [
      "pty",
      "fs_watch",
      "tunnel.forward",
      "driver",
      "a11y",
      "background_input",
      "desktop_stream",
      "window_stream",
      "h264_sw",
      "quic_media",
      "windows",
      "launch_app",
      "clipboard.text",
      "presence",
      "presence.cursor_shape",
      "audio.desktop",
      "audio.uplink",
      "audio.opus",
      "process.exec_ledger"
    ],
    "features_optional": [
      "hotspot",
      "spawn",
      "exit",
      "host_ports",
      "process.services",
      "relay_attach",
      "h264_hw",
      "audio.per_app",
      "clipboard.files",
      "clipboard.image",
      "teleport.*",
      "volume.mount",
      "process.exec_ledger",
      "files.multipart",
      "fs.run_as",
      "fs.xattr",
      "process.run_as",
      "volume.binds"
    ],
    "feature_attributes": {
      "presence.cursor_shape": {
        "hit_test": "atspi",
        "system": "xfixes",
        "probe": "xtest"
      }
    },
    "codecs_required": [
      "openh264"
    ],
    "auth_modes": [
      "local",
      "pod-secret",
      "kubevirt-bridge"
    ],
    "units": {
      "supervisord": [
        "dbus-system",
        "desktop",
        "audio",
        "cua-env-token-sync",
        "cua-spacesd"
      ],
      "systemd": [
        "cua-desktop.service",
        "cua-audio.service",
        "cua-env-token-sync.service",
        "cua-spacesd.service"
      ]
    },
    "unit_processes": {
      "dbus-system": "dbus-daemon --system",
      "desktop": "Xvfb",
      "audio": "pipewire",
      "cua-env-token-sync": "token-sync",
      "cua-spacesd": "cua-spacesd"
    },
    "compat_links": [
      {
        "path": "/usr/local/bin/cua-env-driver",
        "target": "cua-spacesd"
      },
      {
        "path": "/usr/local/bin/cua-guestd",
        "target": "cua-spacesd"
      },
      {
        "path": "/opt/cua/bin/start-env-driver.sh",
        "target": "start-spacesd.sh"
      },
      {
        "path": "/opt/cua/bin/start-guestd.sh",
        "target": "start-spacesd.sh"
      },
      {
        "path": "/etc/cua-image/env-driver-source",
        "target": "spacesd-source"
      },
      {
        "path": "/etc/cua-image/guestd-source",
        "target": "spacesd-source"
      },
      {
        "unit_alias": "cua-env-driver.service",
        "unit": "cua-spacesd.service"
      },
      {
        "unit_alias": "cua-guestd.service",
        "unit": "cua-spacesd.service"
      }
    ],
    "apps": {
      "chromium": [
        "/usr/lib/chromium/chromium",
        "--version"
      ],
      "python3": [
        "python3",
        "--version"
      ]
    },
    "launch_app": {
      "app": "/opt/cua/bin/cua-chromium",
      "args": [
        "--no-first-run",
        "--no-default-browser-check",
        "--new-window",
        "about:blank"
      ],
      "window_match": "Chromium",
      "timeout_s": 60
    },
    "parity_expected_diff": [
      "kernel",
      "runtime",
      "init",
      "cpu_model",
      "cpu_count",
      "memory_mib",
      "clock_skew_ms",
      "gpu",
      "encoder"
    ],
    "resources": {
      "min_disk_gib": 2,
      "min_shm_mib": 256,
      "min_memory_mib": 1024
    },
    "tz": "Etc/UTC",
    "locale": "C.UTF-8",
    "dns_probe": "archive.ubuntu.com",
    "av_skew_budget_ms": {
      "container": 40,
      "gvisor": 80,
      "vm": 40
    }
  }
}
