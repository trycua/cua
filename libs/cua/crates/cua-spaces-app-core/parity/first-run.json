{
  "name": "first-run",
  "about": "The 0.10.0 first run, one screen state per storyboard frame (v2-01 to v2-09, 16, 17): connect your agent, then the agent and this computer checked, a first request that works on this computer, the optional extra Space (macOS first, never blocking Done), the plan card after the first success, and Home's to-do list after Finish later. Each case patches the base input; every app draws firstRun.view's words and must say the same.",
  "base": {
    "step": "setup",
    "hostOs": "macos",
    "agents": [
      { "agent": "claude-code", "name": "Claude Code", "installed": true, "configured": true },
      { "agent": "codex", "name": "Codex", "installed": true, "configured": false }
    ],
    "agent": "claude-code",
    "signedIn": true,
    "host": { "configured": true, "running": true, "online": true, "permissions": [{ "id": "accessibility", "granted": true }, { "id": "screen-recording", "granted": true }] },
    "offers": [
      { "os": "linux", "time": "about 2 min", "size": "1.2 GB download" },
      { "os": "macos", "time": "10 to 30 min the first time", "size": "22 GB download" }
    ],
    "extra": { "phase": "none" },
    "plan": { "metered": true, "plan": "free", "sessionsLimit": 2, "hoursLimit": 20, "accountApp": "https://app.cua.ai" }
  },
  "cases": [
    { "name": "01 connect", "patch": { "step": "connect", "agent": null } },
    { "name": "01 connect, only Codex installed", "patch": { "step": "connect", "agent": null, "agents": [{ "agent": "codex", "name": "Codex", "installed": true, "configured": false }] } },
    { "name": "02 checking", "patch": { "agents": null, "host": null } },
    { "name": "03 ready, choose", "patch": {} },
    { "name": "04 ready, creating macOS", "patch": { "extra": { "phase": "creating", "name": "macOS 1", "os": "macos", "detail": "Downloading macOS · 4.2 of 22.3 GB · 85 MB/s · about 4 min", "fraction": 0.19 } } },
    { "name": "05 restart the agent", "patch": { "agentOpenBeforeSetup": true, "extra": { "phase": "creating", "name": "macOS 1", "os": "macos", "detail": "Downloading macOS · 4.2 of 22.3 GB · 85 MB/s · about 4 min", "fraction": 0.19 } }, "todos": true },
    { "name": "06 let Cua control this Mac", "patch": { "host": { "configured": true, "running": true, "online": true, "permissions": [{ "id": "accessibility", "granted": false, "settingsUrl": "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility" }] } }, "todos": true },
    { "name": "07 sign in", "patch": { "signedIn": false, "host": { "configured": false, "running": false, "permissions": [] } }, "todos": true },
    { "name": "08 first success, not now", "patch": { "agentUsedAt": "18:12", "extra": { "phase": "not-now" }, "plan": { "metered": true, "plan": "free", "dismissed": true } } },
    { "name": "16 first success, Pro card", "patch": { "agentUsedAt": "18:12", "extra": { "phase": "not-now" } } },
    { "name": "17 first success, Teams card", "patch": { "agentUsedAt": "18:12", "extra": { "phase": "not-now" }, "plan": { "metered": true, "plan": "free", "teammates": true, "accountApp": "https://app.cua.ai" } } },
    { "name": "macOS made, ready", "patch": { "agentUsedAt": "18:12", "extra": { "phase": "ready", "name": "macOS 1", "os": "macos" }, "plan": { "metered": true, "plan": "pro" } }, "todos": true },
    { "name": "an Intel Mac: Linux only", "patch": { "offers": [{ "os": "linux", "time": "about 2 min" }, { "os": "macos", "time": "10 to 30 min the first time", "blocked": "This Mac can't run macOS Spaces: they need Apple silicon." }] } },
    { "name": "a Windows PC", "patch": { "hostOs": "windows", "host": { "configured": true, "running": true, "online": true, "permissions": [] }, "offers": [{ "os": "linux", "time": "about 2 min" }] } }
  ]
}
