          "action": {
            "type": "drive-storage",
            "action": {
              "type": "checked",
              "check": {
                "ok": false,
                "reachable": true,
                "authorized": true,
                "versioning": false,
                "detail": "Bucket versioning is off; turn it on for cua-volume.",
