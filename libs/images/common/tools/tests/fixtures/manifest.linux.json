{
  "aliases": [
    "cua-desktop-linux"
  ],
  "annotations": {
    "ai.cua.env-driver": "true",
    "ai.cua.image.os": "linux",
    "ai.cua.image.tier": "full",
    "ai.cua.image.variant": "rootfs",
    "ai.cua.spacesd": "true"
  },
  "apps": {
    "chromium": [
      "/usr/lib/chromium/chromium",
      "--version"
    ],
    "firefox": [
      "firefox",
      "--version"
    ],
    "python3": [
      "python3",
      "--version"
    ]
  },
  "arch": "arm64",
  "audio": {
    "default_sink": "cua_desktop",
    "default_source": "cua_mic",
    "server": "pipewire + wireplumber + pipewire-pulse",
    "uplink_input_sink": "cua_mic_in"
  },
  "auth_modes": [
    "local",
    "pod-secret",
    "kubevirt-bridge"
  ],
  "av_skew_budget_ms": {
    "container": 40,
    "gvisor": 80,
    "vm": 40
  },
  "codecs_required": [
    "openh264"
  ],
  "compat_links": [
    {
      "path": "/usr/local/bin/cua-env-driver",
      "target": "cua-spacesd"
    },
    {
      "path": "/usr/local/bin/cua-guestd",
      "target": "cua-spacesd"
    },
    {
      "path": "/opt/cua/bin/start-env-driver.sh",
      "target": "start-spacesd.sh"
    },
    {
      "path": "/opt/cua/bin/start-guestd.sh",
      "target": "start-spacesd.sh"
    },
    {
      "path": "/etc/cua-image/env-driver-source",
      "target": "spacesd-source"
    },
    {
      "path": "/etc/cua-image/guestd-source",
      "target": "spacesd-source"
    },
    {
      "unit": "cua-spacesd.service",
      "unit_alias": "cua-env-driver.service"
    },
    {
      "unit": "cua-spacesd.service",
      "unit_alias": "cua-guestd.service"
    }
  ],
  "display": {
    "name": ":1",
    "resolution": "1280x800",
    "user": "cua"
  },
  "dns_probe": "archive.ubuntu.com",
  "feature_attributes": {
    "presence.cursor_shape": {
      "hit_test": "atspi",
      "probe": "xtest",
      "system": "xfixes"
    }
  },
  "features_optional": [
    "hotspot",
    "relay_attach",
    "h264_hw",
    "audio.per_app",
    "clipboard.files",
    "clipboard.image",
    "teleport.*",
    "volume.mount"
  ],
  "features_required": [
    "pty",
    "fs_watch",
    "tunnel.forward",
    "driver",
    "a11y",
    "background_input",
    "desktop_stream",
    "window_stream",
    "h264_sw",
    "quic_media",
    "windows",
    "launch_app",
    "clipboard.text",
    "presence",
    "presence.cursor_shape",
    "audio.desktop",
    "audio.uplink",
    "audio.opus"
  ],
  "fixtures": {
    "apps": [
      "grid",
      "form",
      "http",
      "tone",
      "avsync"
    ],
    "root": "/opt/cua/fixtures"
  },
  "init": "supervisord",
  "launch_app": {
    "app": "/opt/cua/bin/cua-chromium",
    "args": [
      "--no-first-run",
      "--no-default-browser-check",
      "--new-window",
      "about:blank"
    ],
    "timeout_s": 60,
    "window_match": "Chromium"
  },
  "locale": "C.UTF-8",
  "name": "linux",
  "os": "linux",
  "parity": {
    "expected_diff": [
      "kernel",
      "runtime",
      "init",
      "cpu_model",
      "cpu_count",
      "memory_mib",
      "clock_skew_ms",
      "gpu",
      "encoder"
    ]
  },
  "ref": "",
  "resources": {
    "min_disk_gib": 6,
    "min_memory_mib": 1024,
    "min_shm_mib": 256
  },
  "schema_version": 1,
  "services": [
    {
      "auth": "bearer token: CUA_ENV_TOKEN or /run/cua/env-token",
      "component": "cua-spacesd",
      "name": "env",
      "port": 3211,
      "protocol": "grpc",
      "readiness": "tcp"
    },
    {
      "component": "cua-spacesd",
      "name": "viewer",
      "port": 3211,
      "protocol": "http",
      "readiness": "http:/viewer/"
    },
    {
      "component": "cua-spacesd",
      "name": "env-media",
      "port": 3212,
      "protocol": "udp"
    }
  ],
  "simulator_runtimes": [],
  "source_revision": "deadbeef",
  "spacesd": {
    "codecs_compiled": [
      "nvenc",
      "vaapi",
      "qsv",
      "amf",
      "openh264"
    ],
    "cua_driver_version": "0.3.0",
    "git_sha": "0123456789abcdef",
    "path": "/usr/local/bin/cua-spacesd",
    "present": true,
    "protocol_revision": 3,
    "source": "local",
    "tools_count": 42,
    "tools_sha256": "abababababababababababababababababababababababababababababababab",
    "version": "0.1.0"
  },
  "tier": "full",
  "tools": {
    "cargo": {
      "argv": [
        "cargo",
        "--version"
      ],
      "expect": "^cargo 1\\.98\\.1 "
    },
    "cmake": {
      "argv": [
        "cmake",
        "--version"
      ],
      "expect": "^cmake version 3\\."
    },
    "curl": {
      "argv": [
        "/bin/sh",
        "-c",
        "curl --version | cut -d' ' -f1-2"
      ],
      "expect": "^curl 8\\."
    },
    "docker": {
      "argv": [
        "docker",
        "--version"
      ],
      "expect": "^Docker version 29\\.8\\.1,"
    },
    "fd": {
      "argv": [
        "fd",
        "--version"
      ],
      "expect": "^fd(find)? [0-9]"
    },
    "gcc": {
      "argv": [
        "gcc",
        "--version"
      ],
      "expect": "^gcc .* 13\\."
    },
    "gh": {
      "argv": [
        "gh",
        "--version"
      ],
      "expect": "^gh version 2\\.101\\.0 "
    },
    "git": {
      "argv": [
        "git",
        "--version"
      ],
      "expect": "^git version 2\\."
    },
    "git-lfs": {
      "argv": [
        "git-lfs",
        "--version"
      ],
      "expect": "^git-lfs/3\\."
    },
    "go": {
      "argv": [
        "go",
        "version"
      ],
      "expect": "^go version go1\\.27\\.1 "
    },
    "jq": {
      "argv": [
        "jq",
        "--version"
      ],
      "expect": "^jq-1\\.7"
    },
    "make": {
      "argv": [
        "make",
        "--version"
      ],
      "expect": "^GNU Make 4\\."
    },
    "ninja": {
      "argv": [
        "ninja",
        "--version"
      ],
      "expect": "^1\\."
    },
    "node": {
      "argv": [
        "node",
        "--version"
      ],
      "expect": "^v24\\.21\\.0$"
    },
    "pkg-config": {
      "argv": [
        "pkg-config",
        "--version"
      ],
      "expect": "^[0-9]"
    },
    "pnpm": {
      "argv": [
        "pnpm",
        "--version"
      ],
      "expect": "^12\\.6\\.0$"
    },
    "python3": {
      "argv": [
        "python3",
        "--version"
      ],
      "expect": "^Python 3\\.12\\."
    },
    "ripgrep": {
      "argv": [
        "rg",
        "--version"
      ],
      "expect": "^ripgrep 14\\."
    },
    "rustc": {
      "argv": [
        "rustc",
        "--version"
      ],
      "expect": "^rustc 1\\.98\\.1 "
    },
    "rustup": {
      "argv": [
        "rustup",
        "--version"
      ],
      "expect": "^rustup 1\\.29\\.1"
    },
    "unzip": {
      "argv": [
        "unzip",
        "-v"
      ],
      "expect": "^UnZip 6\\."
    },
    "uv": {
      "argv": [
        "uv",
        "--version"
      ],
      "expect": "^uv 0\\.12\\.19"
    },
    "zip": {
      "argv": [
        "/bin/sh",
        "-c",
        "zip -v | sed -n 2p"
      ],
      "expect": "Zip 3\\.0"
    }
  },
  "tz": "Etc/UTC",
  "unit_processes": {
    "audio": "pipewire",
    "cua-env-token-sync": "token-sync",
    "cua-spacesd": "cua-spacesd",
    "dbus-system": "dbus-daemon --system",
    "desktop": "Xvfb"
  },
  "units": [
    "dbus-system",
    "desktop",
    "audio",
    "cua-env-token-sync",
    "cua-spacesd"
  ],
  "variant": "rootfs"
}
