# Fleet claim secrets on KubeVirt: when a virtio-fs device (virtio id 26)
# appears, pull in run-cua.mount (tag cua-claim-secrets -> /run/cua). Without
# such a device the mount is never attempted, so VMs without the share (local
# QEMU, non-Fleet KubeVirt) boot clean instead of "degraded".
SUBSYSTEM=="virtio", ATTR{device}=="0x001a", TAG+="systemd", ENV{SYSTEMD_WANTS}+="run-cua.mount"
