#!/usr/bin/env python3
"""bin/ci: run, on your machine, the CI checks that your change affects.

It reads the files that differ from the merge base with origin/main (plus
anything uncommitted), picks the checks those files can break, runs them in
parallel and prints the exact command that fixes each failure. The commands
are the ones the GitHub workflows run; `bin/ci --verify-sync` fails when a
workflow stops running one of them, so the two cannot drift apart unseen.

  bin/ci                 checks for the files you changed (default)
  bin/ci --quick         seconds: formatting, lockfiles, headers, lint; no builds
                         (use this on shared hosts; heavy checks go to CI or a VM)
  bin/ci --full          every check, whatever you changed
  bin/ci --fix           apply the safe fixers (formatters, lockfiles,
                         generators), then check again
  bin/ci --list          show the plan without running it
  bin/ci --only ID,...   run only these checks (ids from --list)
  bin/ci --signoff       after a green run, set the `local-ci` commit status
  bin/ci --install-hook  run bin/ci before every git push (opt-in)

Disk safety: heavy checks (cargo test/clippy/build, cross-target checks) run one
at a time, lean (no incremental, no debuginfo, sccache if installed) in a
per-run target dir that is deleted on exit (--keep-target keeps it). They are
skipped when free disk is below CUA_CI_MIN_FREE_GB (default 40), and stopped
when the target dir passes CUA_CI_MAX_TARGET_GB (default 15) or free disk drops
below CUA_CI_MIN_FREE_FLOOR_GB (default 25). Exit code 3 means a guard stopped
the run: rerun in CI.

Run `bin/ci --help` for every option. Docs: docs/contributing/CI.md.
"""

from __future__ import annotations

import argparse
import atexit
import contextlib
import concurrent.futures
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Dict, Iterable, List, Optional, Sequence, Tuple

# CUA_CI_ROOT runs this copy against another checkout (used to replay old commits).
ROOT = Path(os.environ.get("CUA_CI_ROOT") or Path(__file__).resolve().parent.parent).resolve()
HOOK_MARKER = "# bin/ci pre-push hook"
CHAINED_HOOK = "pre-push.pre-bin-ci"
STATUS_CONTEXT = "local-ci"
IS_WINDOWS = os.name == "nt"


def find_bash() -> str:
    """The bash that runs the checks' commands (they are bash). On Windows that is Git for
    Windows' bash (CUA_CI_BASH overrides it): a bare `bash` there is usually System32\\bash.exe,
    which is WSL and would run the checks inside a Linux distribution."""
    if not IS_WINDOWS:
        return "bash"
    given = os.environ.get("CUA_CI_BASH")
    if given:
        return given
    git = shutil.which("git")
    if git:
        # .../Git/cmd/git.exe, .../Git/bin/git.exe or .../Git/mingw64/bin/git.exe: the Git root is above it.
        for root in list(Path(git).resolve().parents)[:3]:
            for rel in (("bin", "bash.exe"), ("usr", "bin", "bash.exe")):
                candidate = root.joinpath(*rel)
                if candidate.exists():
                    return str(candidate)
    sys.exit("bin/ci: needs Git for Windows' bash (install Git for Windows, or set CUA_CI_BASH to its bash.exe); it will not use `bash` from PATH, which may be WSL")


BASH = find_bash()
_shim_dir: Optional[str] = None


def python3_shim_dir() -> Optional[str]:
    """Windows: a directory with a `python3` for the checks (Python there is `python`, or the Store stub)."""
    global _shim_dir
    if not IS_WINDOWS:
        return None
    if _shim_dir is None:
        _shim_dir = tempfile.mkdtemp(prefix="bin-ci-shim-")
        exe = Path(sys.executable).as_posix()
        for name in ("python3", "python"):
            with open(os.path.join(_shim_dir, name), "w", newline="\n") as fh:
                fh.write(f'#!/bin/sh\nexec "{exe}" "$@"\n')
        atexit.register(shutil.rmtree, _shim_dir, True)
    return _shim_dir

# ---------------------------------------------------------------- model


@dataclass
class Check:
    id: str
    title: str
    cmd: str  # bash, run from `cwd`
    cwd: str = "."
    fix: Optional[str] = None  # shell command that repairs a failure
    safe_fix: bool = False  # bin/ci --fix may run `fix` on its own
    fix_from_output: Optional[str] = None  # regex: group 1 is a fix command
    hint: str = ""  # shown on failure when there is no fix command
    tools: Tuple[str, ...] = ()  # executables that must exist
    requires: Tuple[Tuple[str, str], ...] = ()  # (path that must exist, how to create it)
    group: Optional[str] = None  # checks in one group run one at a time
    heavy: bool = False  # builds something large; skipped by --quick
    tier: str = "quick"  # quick | build (skipped by --quick)
    env: Dict[str, str] = field(default_factory=dict)
    ci: Tuple[Tuple[str, str], ...] = ()  # (workflow, text it must contain)
    advisory: bool = False  # never fails the run
    isolate_home: bool = False  # run with an empty HOME, as on a fresh CI runner
    classify: Optional[Callable[[str, int], Tuple[str, str]]] = None  # (log, rc) -> (status, detail)
    skip_reason: Optional[str] = None  # planned but cannot run here


@dataclass
class Result:
    check: Check
    status: str  # pass | FAIL | skip | fixed | warn
    seconds: float = 0.0
    log: Optional[Path] = None
    detail: str = ""



# ---------------------------------------------------------------- disk guard

GUARD_EXIT = 3
GUARD_WATCH_SECS = 15.0


def env_gb(name: str, default: float) -> float:
    try:
        return float(os.environ[name])
    except (KeyError, ValueError):
        return default


def min_free_gb() -> float:
    return env_gb("CUA_CI_MIN_FREE_GB", 40.0)


def floor_free_gb() -> float:
    return env_gb("CUA_CI_MIN_FREE_FLOOR_GB", 25.0)


def max_target_gb() -> float:
    return env_gb("CUA_CI_MAX_TARGET_GB", 15.0)


def is_heavy(c: "Check") -> bool:
    """Checks that build something large: the ones the disk guard watches."""
    return c.heavy or c.tier == "build"


def disk_free_gb(path: Path) -> float:
    """Free GB on the volume holding `path` (its nearest existing parent).

    CUA_CI_FAKE_FREE_GB overrides it, for tests of the guard.
    """
    fake = os.environ.get("CUA_CI_FAKE_FREE_GB")
    if fake:
        try:
            return float(fake)
        except ValueError:
            pass
    p = Path(path)
    while not p.exists() and p != p.parent:
        p = p.parent
    return shutil.disk_usage(p).free / 1e9


def dir_size_gb(path: Path) -> float:
    if not Path(path).exists():
        return 0.0
    try:
        out = subprocess.run(["du", "-sk", str(path)], capture_output=True, text=True)
        return int(out.stdout.split()[0]) * 1024 / 1e9
    except (IndexError, ValueError, OSError):
        total = 0
        for dp, _, files in os.walk(path):
            for f in files:
                try:
                    total += os.lstat(os.path.join(dp, f)).st_size
                except OSError:
                    pass
        return total / 1e9


def preflight_reason(free_gb: float, min_free: float) -> Optional[str]:
    """Why heavy checks must not start, or None."""
    if free_gb < min_free:
        return f"skipped: low disk ({free_gb:.0f} GB free, need {min_free:.0f} GB); CI will run these"
    return None


def watch_reason(free_gb: float, target_gb: float, floor: float, cap: float) -> Optional[str]:
    """Why a running heavy check must be stopped, or None."""
    if target_gb > cap:
        return f"target dir is {target_gb:.1f} GB, over the {cap:.0f} GB cap (CUA_CI_MAX_TARGET_GB)"
    if free_gb < floor:
        return f"free disk is {free_gb:.0f} GB, under the {floor:.0f} GB floor (CUA_CI_MIN_FREE_FLOOR_GB)"
    return None


class DiskGuard:
    """Watches the target dir and free disk while cargo runs; stops it when over budget."""

    def __init__(self, target: Path, interval: Optional[float] = None) -> None:
        self.target = Path(target)
        self.interval = interval if interval is not None else env_gb("CUA_CI_WATCH_SECS", GUARD_WATCH_SECS)
        self.tripped: Optional[str] = None
        self.procs: Dict[int, subprocess.Popen] = {}
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.thread = threading.Thread(target=self._loop, daemon=True)

    def start(self) -> None:
        self.thread.start()

    def close(self) -> None:
        self.stop.set()

    def register(self, proc: subprocess.Popen) -> None:
        with self.lock:
            self.procs[proc.pid] = proc

    def unregister(self, proc: subprocess.Popen) -> None:
        with self.lock:
            self.procs.pop(proc.pid, None)

    def check_once(self) -> Optional[str]:
        reason = watch_reason(disk_free_gb(self.target), dir_size_gb(self.target), floor_free_gb(), max_target_gb())
        if reason and not self.tripped:
            self.tripped = reason
            self.kill_all()
        return reason

    def kill_all(self) -> None:
        with self.lock:
            procs = list(self.procs.values())
        if IS_WINDOWS:
            for p in procs:
                subprocess.run(["taskkill", "/T", "/F", "/PID", str(p.pid)], capture_output=True)
            return
        for sig in (signal.SIGTERM, signal.SIGKILL):
            for p in procs:
                try:
                    os.killpg(p.pid, sig)
                except (ProcessLookupError, PermissionError):
                    pass
            if sig == signal.SIGTERM:
                deadline = time.monotonic() + 5
                while time.monotonic() < deadline and any(p.poll() is None for p in procs):
                    time.sleep(0.1)

    def _loop(self) -> None:
        while not self.stop.wait(self.interval):
            if self.check_once():
                return


def lean_env() -> Dict[str, str]:
    """Defaults that keep cargo's disk use small; anything already in the environment wins."""
    env = {"CARGO_INCREMENTAL": "0", "CARGO_PROFILE_DEV_DEBUG": "0", "CARGO_PROFILE_TEST_DEBUG": "0"}
    if have("sccache"):
        env["RUSTC_WRAPPER"] = "sccache"
    return {k: v for k, v in env.items() if k not in os.environ}


def run_target_dir(keep: bool) -> Tuple[Path, bool]:
    """(target dir, delete it on exit). A CARGO_TARGET_DIR you set is never deleted."""
    if os.environ.get("CARGO_TARGET_DIR"):
        return Path(os.environ["CARGO_TARGET_DIR"]).resolve(), False
    if keep:
        return ROOT / ".bin-ci-target", False
    return ROOT / f".bin-ci-target-{os.getpid()}", True


def sweep_stale_targets() -> None:
    """Delete per-run target dirs left by runs that were killed."""
    for d in ROOT.glob(".bin-ci-target-*"):
        m = re.fullmatch(r"\.bin-ci-target-(\d+)", d.name)
        if not m:
            continue
        try:
            os.kill(int(m.group(1)), 0)
        except ProcessLookupError:
            shutil.rmtree(d, ignore_errors=True)
        except PermissionError:
            pass


def per_crate(template: str, names: Sequence[str], tail: str = "") -> str:
    """One cargo invocation per crate (smaller builds), failing if any failed.

    template has a `{p}` placeholder, e.g. "cargo clippy --locked {p} --all-targets".
    """
    if len(names) <= 1:
        return template.format(p=" ".join(f"-p {n}" for n in names)) + tail
    steps = "; ".join(f"{template.format(p='-p ' + n)}{tail} || rc=1" for n in names)
    return f"rc=0; {steps}; exit $rc"


# ---------------------------------------------------------------- shell helpers


def sh(cmd: Sequence[str], cwd: Optional[Path] = None, check: bool = False) -> str:
    out = subprocess.run(list(cmd), cwd=str(cwd or ROOT), capture_output=True, text=True)
    if check and out.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)}: {out.stderr.strip()}")
    return out.stdout


def git(*args: str) -> str:
    return sh(["git", *args])


def have(tool: str) -> bool:
    return shutil.which(tool) is not None


def color(text: str, code: str) -> str:
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{code}m{text}\033[0m"


# ---------------------------------------------------------------- toolchains


def pinned_rust_channel() -> Optional[str]:
    """The toolchain CI pins (dtolnay/rust-toolchain@1.97.1 and rust-toolchain.toml)."""
    for p in (ROOT / "libs/cua/rust-toolchain.toml", ROOT / "libs/cua-driver/rust/rust-toolchain.toml"):
        if p.exists():
            m = re.search(r'^channel\s*=\s*"([^"]+)"', p.read_text(), re.M)
            if m:
                return m.group(1)
    return None


def rust_env(notes: List[str]) -> Dict[str, str]:
    """PATH and RUSTUP_TOOLCHAIN so `cargo` is the pinned rustup toolchain.

    A Homebrew `cargo` ahead of the rustup proxies ignores rust-toolchain.toml,
    and a newer rustfmt or clippy reports different findings than CI does.
    """
    env: Dict[str, str] = {}
    channel = pinned_rust_channel()
    rustup = find_rustup()
    if not rustup or not channel:
        if have("cargo"):
            notes.append("rustup not found: using the cargo on PATH; rustfmt and clippy may differ from CI")
        return env
    installed = sh([rustup, "toolchain", "list"])
    if not any(line.startswith(channel) for line in installed.splitlines()):
        notes.append(
            f"Rust {channel} (the CI toolchain) is not installed; using the default toolchain. "
            f"Install it: rustup toolchain install {channel} --component clippy,rustfmt"
        )
        return env
    env["RUSTUP_TOOLCHAIN"] = channel
    proxy_dirs = [Path(rustup).resolve().parent, Path(rustup).parent]
    brew = Path(rustup).resolve().parent.parent / "bin"  # Homebrew keeps the proxies next to rustup
    for d in (*RUSTUP_DIRS, Path.home() / ".cargo/bin", brew, *proxy_dirs):
        if (d / "cargo").exists() and (d / "cargo-clippy").exists():
            current = shutil.which("cargo")
            if current is None or Path(current).parent != d:
                env["PATH"] = f"{d}{os.pathsep}{os.environ.get('PATH', '')}"
            break
    return env


# Homebrew's rustup is keg-only: its `rustup` and the cargo/clippy proxies live
# here, not on PATH, while Homebrew's own `cargo` (a different version that
# ignores rust-toolchain.toml) is.
RUSTUP_DIRS = (Path("/opt/homebrew/opt/rustup/bin"), Path("/usr/local/opt/rustup/bin"))


def find_rustup() -> Optional[str]:
    found = shutil.which("rustup")
    if found:
        return found
    exe = "rustup.exe" if IS_WINDOWS else "rustup"
    for d in (Path.home() / ".cargo/bin", *RUSTUP_DIRS):
        if (d / exe).exists():
            return str(d / exe)
    return None


def rust_pin_error(env: Dict[str, str]) -> Optional[str]:
    """None when the `cargo` and `cargo clippy` bin/ci will run match the pinned toolchain, else why not.

    A cargo from outside rustup (Homebrew's, a distro's) ignores rust-toolchain.toml and
    reports lint findings CI never sees.
    """
    channel = pinned_rust_channel()
    if not channel or not re.fullmatch(r"\d+\.\d+(\.\d+)?", channel) or not have("cargo"):
        return None
    full = {**os.environ, **env}
    probes = (("cargo --version", ["cargo", "--version"], rf"^cargo {re.escape(channel)}\b"),
              ("cargo clippy --version", ["cargo", "clippy", "--version"], rf"^clippy 0\.1\.{channel.split('.')[1]}\b"))
    for label, cmd, rx in probes:
        out = subprocess.run(cmd, capture_output=True, text=True, cwd=str(ROOT / "libs/cua-driver/rust" if (ROOT / "libs/cua-driver/rust").exists() else ROOT), env=full)
        got = out.stdout.strip() or out.stderr.strip()
        if out.returncode != 0 or not re.search(rx, got):
            if label == "cargo clippy --version" and out.returncode != 0 and "no such command" in got:
                return f"clippy is not installed for Rust {channel}: rustup component add clippy --toolchain {channel}"
            return (f"`{label}` reports {got!r}, but CI pins Rust {channel} (rust-toolchain.toml). "
                    f"Homebrew's cargo ignores the pin. Use rustup's: put ~/.cargo/bin (or /opt/homebrew/opt/rustup/bin) "
                    f"before /opt/homebrew/bin on PATH, and run `rustup toolchain install {channel} --component clippy,rustfmt`.")
    return None


PNPM_SHIM_DIR = ROOT / "scripts/ci/lib/pnpm"
PNPM_PIN_RX = re.compile(r"pnpm@\d+\.\d+\.\d+(\+\S+)?")


def use_pnpm_shim() -> None:
    """Put the corepack pnpm shim first on PATH for this run and everything it starts.

    Like the rustup handling above: the pnpm on a machine is whatever it is (pnpm 11 on
    ours), but each lockfile must be written by the pnpm that package pins in
    packageManager, which is what CI's pnpm/action-setup installs. The shim runs that
    version through corepack and fails with a clear message when it cannot.
    """
    if IS_WINDOWS or not (PNPM_SHIM_DIR / "pnpm").exists():
        return
    path = os.environ.get("PATH", "")
    if str(PNPM_SHIM_DIR) not in path.split(os.pathsep):
        os.environ["PATH"] = f"{PNPM_SHIM_DIR}{os.pathsep}{path}"


def pnpm_pin_problems() -> List[str]:
    """Every package with a pnpm-lock.yaml must pin its pnpm in package.json (packageManager)."""
    problems = []
    for lock in sorted(set(git("ls-files", "--cached", "--others", "--exclude-standard", "--", "*pnpm-lock.yaml").split())):
        if re.search(r"(^|/)(node_modules|target)/", lock):
            continue
        pkg = (ROOT / lock).parent / "package.json"
        rel = pkg.relative_to(ROOT).as_posix()
        if not pkg.exists():
            problems.append(f"{lock}: no package.json next to the lockfile")
            continue
        try:
            pin = json.loads(pkg.read_text(encoding="utf-8")).get("packageManager", "")
        except ValueError as e:
            problems.append(f"{rel}: not valid JSON ({e})")
            continue
        if not PNPM_PIN_RX.fullmatch(pin or ""):
            problems.append(f'{rel}: "packageManager" is {pin!r}; pin the pnpm that wrote {lock}, e.g. "packageManager": "pnpm@9.0.4"')
    return problems


def pnpm_cmd(version: Optional[str] = None) -> str:
    """The pnpm command for a package. On Unix it is `pnpm`: the shim (use_pnpm_shim) resolves
    the version from the package's own packageManager pin, so no version is passed around."""
    if not IS_WINDOWS:
        return "pnpm"
    # Windows has no sh shim: fall back to npx at the pinned version when the local major differs.
    if not version:
        return "pnpm"
    local = sh(["pnpm", "--version"], cwd=Path(tempfile.gettempdir())).strip() if have("pnpm") else ""
    if local.split(".")[0] == version.split(".")[0]:
        return "pnpm"
    return f"npx -y pnpm@{version}"


def package_manager(pkg_dir: Path) -> Optional[str]:
    p = pkg_dir / "package.json"
    if not p.exists():
        return None
    m = re.match(r"pnpm@([0-9.]+)", json.loads(p.read_text()).get("packageManager", ""))
    return m.group(1) if m else None


# ---------------------------------------------------------------- change set


@dataclass
class Changes:
    base: str
    base_desc: str
    files: List[str]  # every changed path, deleted ones included
    full: bool = False

    def touches(self, pattern: str) -> List[str]:
        if self.full:
            return ["(full run)"]
        rx = re.compile(pattern)
        return [f for f in self.files if rx.search(f)]

    def existing(self, pattern: str, suffixes: Iterable[str] = ()) -> List[str]:
        rx = re.compile(pattern)
        suf = tuple(suffixes)
        return [f for f in self.files if rx.search(f) and (ROOT / f).is_file() and (not suf or f.endswith(suf))]


def find_base(explicit: Optional[str]) -> Tuple[str, str]:
    if explicit:
        sha = git("rev-parse", "--verify", f"{explicit}^{{commit}}").strip()
        if not sha:
            sys.exit(f"bin/ci: cannot resolve --base {explicit}")
        return sha, explicit
    for ref in ("origin/main", "main"):
        if git("rev-parse", "-q", "--verify", ref).strip():
            mb = git("merge-base", "HEAD", ref).strip()
            if mb:
                return mb, f"merge base with {ref}"
    sys.exit("bin/ci: cannot find origin/main; run `git fetch origin main` or pass --base REF")


def changed_files(base: str) -> List[str]:
    out = set()
    for args in (("diff", "--name-only", f"{base}...HEAD"), ("diff", "--name-only", "HEAD"), ("ls-files", "--others", "--exclude-standard")):
        out.update(line for line in git(*args).splitlines() if line)
    return sorted(out)


# ---------------------------------------------------------------- Rust workspaces

# The Windows CI lane of each workspace, read from its workflow so the
# cross-compiled local run checks exactly the packages CI does:
# workspace -> (workflow, regex whose group 1 is the cargo arguments, local cargo subcommand)
WINDOWS_LANES = {
    "libs/cua": ("ci-cua-sdk.yml", r"- name: Clippy \(native\)\s+run: >\s+cargo clippy (--locked .*? -- -D warnings)", "clippy"),
    "libs/cua-spacesd": ("ci-cua-spacesd.yml", r"- name: Clippy\s+run: cargo clippy (--workspace --all-targets --locked -- -D warnings)", "clippy"),
    "libs/cua-driver/rust": ("ci-rust-windows.yml", r"run: cargo test (-p cua-driver .*?--all-targets) --no-run --locked", "check"),
}


def windows_lane(root: str) -> Optional[Tuple[str, List[str]]]:
    """(cargo args, packages) of the workspace's Windows CI lane, or None."""
    lane = WINDOWS_LANES.get(root)
    if not lane:
        return None
    path = ROOT / ".github/workflows" / lane[0]
    m = re.search(lane[1], path.read_text(), re.S) if path.exists() else None
    if not m:
        return None
    args = " ".join(m.group(1).split())
    return args, re.findall(r"-p (\S+)", args)


@dataclass
class Workspace:
    root: str  # repo-relative dir
    members: Dict[str, str]  # package name -> repo-relative dir
    path_deps: Dict[str, List[str]]  # package -> in-workspace packages it depends on


_ws_cache: Dict[str, Optional[Workspace]] = {}
_ws_lock = threading.Lock()


def package_of(path: str) -> Optional[Tuple[str, str]]:
    """(package dir, package name) of the crate that owns `path`."""
    d = (ROOT / path).parent
    while d != ROOT and ROOT in d.parents:
        manifest = d / "Cargo.toml"
        if manifest.exists():
            text = manifest.read_text(errors="replace")
            m = re.search(r'^\[package\][^\[]*?^name\s*=\s*"([^"]+)"', text, re.M | re.S)
            if m:
                return d.relative_to(ROOT).as_posix(), m.group(1)
        d = d.parent
    return None


def workspace_of(pkg_dir: str, env: Dict[str, str]) -> Optional[Workspace]:
    out = subprocess.run(
        ["cargo", "locate-project", "--workspace", "--message-format", "plain"],
        cwd=str(ROOT / pkg_dir), capture_output=True, text=True, env={**os.environ, **env},
    )
    if out.returncode != 0:
        return None
    root = str(Path(out.stdout.strip()).parent.relative_to(ROOT))
    with _ws_lock:
        if root in _ws_cache:
            return _ws_cache[root]
    meta = subprocess.run(
        ["cargo", "metadata", "--no-deps", "--format-version", "1", "--offline"],
        cwd=str(ROOT / root), capture_output=True, text=True, env={**os.environ, **env},
    )
    ws: Optional[Workspace] = None
    if meta.returncode == 0:
        data = json.loads(meta.stdout)
        members = {p["name"]: str(Path(p["manifest_path"]).parent.relative_to(ROOT)) for p in data["packages"]}
        deps = {p["name"]: sorted({d["name"] for d in p["dependencies"] if d.get("path") and d["name"] in members}) for p in data["packages"]}
        ws = Workspace(root, members, deps)
    with _ws_lock:
        _ws_cache[root] = ws
    return ws


def dependents(ws: Workspace, changed: Iterable[str]) -> List[str]:
    rev: Dict[str, List[str]] = {}
    for pkg, deps in ws.path_deps.items():
        for d in deps:
            rev.setdefault(d, []).append(pkg)
    seen, todo = set(changed), list(changed)
    while todo:
        for r in rev.get(todo.pop(), []):
            if r not in seen:
                seen.add(r)
                todo.append(r)
    return sorted(seen - set(changed))


def deps_closure(ws: Workspace, roots: Iterable[str]) -> set:
    seen, todo = set(), [r for r in roots if r in ws.members]
    while todo:
        p = todo.pop()
        if p not in seen:
            seen.add(p)
            todo.extend(ws.path_deps.get(p, []))
    return seen


def changed_crates(changes: Changes, env: Dict[str, str]) -> Dict[str, Tuple[Workspace, set]]:
    """workspace root -> (workspace, changed package names)."""
    out: Dict[str, Tuple[Workspace, set]] = {}
    for f in changes.files:
        if not (f.endswith(".rs") or f.endswith("Cargo.toml") or "/src/" in f or "/tests/" in f or "/benches/" in f):
            continue
        owner = package_of(f)
        if not owner:
            continue
        pkg_dir, name = owner
        ws = workspace_of(pkg_dir, env)
        if not ws or name not in ws.members:
            continue
        out.setdefault(ws.root, (ws, set()))[1].add(name)
    return out


# ---------------------------------------------------------------- the checks

LOCKFILE_RX = r"(^|/)(Cargo\.(toml|lock)|package(-lock)?\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|uv\.lock|pyproject\.toml|rust-toolchain\.toml)$|^scripts/ci/(check-lockfiles\.sh|lockfile-drift-allowlist\.txt)$"
TSX = "node docs/node_modules/tsx/dist/cli.mjs"
# The pre-commit hook's Prettier.
PRETTIER = "npx -y prettier@3.6.2"
SPACES_APPS = "apps/cua-spaces/ apps/cua-spaces-web/ apps/cua-spaces-desktop/ apps/cua-spaces-mobile/"
SPACES_PRETTIER_RX = r"^apps/cua-spaces(-web|-desktop|-mobile)?/.*\.(ts|tsx|js|jsx|mjs|cjs|mts|cts|json|md|ya?ml|css|html)$"
# CI's pnpm/action-setup reads the root package.json packageManager for docs.
DOCS_DEPS = ("docs/node_modules/tsx/dist/cli.mjs", "{pnpm} --dir docs install --frozen-lockfile")

def docs_install() -> str:
    return DOCS_DEPS[1].format(pnpm=pnpm_cmd(package_manager(ROOT)))


# Docs generators that build Rust (or need extra tools) before they can compare.
DOCS_GENERATOR_NEEDS: Dict[str, Tuple[Tuple[str, ...], Tuple[Tuple[str, str], ...], bool]] = {
    # library: (tools, requires, heavy)
    "cua-driver": (("cargo",), (), True),
    "cua-sdk": (("cargo", "protoc"), (), True),
    "cua-cli": (("cargo", "protoc"), (), True),
    "cua-rust": (("cargo", "protoc", "rustup"), (), True),
    "cua-proto": (("buf",), (), False),
    "cua-sdk-python": (("uv",), (), False),
    "cua-bench": (("uv",), (), False),
    "cua-sdk-ts": ((), (("libs/cua/typescript/node_modules", "npm --prefix libs/cua/typescript ci --ignore-scripts"),), False),
    "lume": (("swift",), (), True),
}

# Web packages: (dir, trigger regex, None for pnpm at the package.json pin or "npm", install, [(id, title, cmd, fix)])
WEB_PACKAGES = [
