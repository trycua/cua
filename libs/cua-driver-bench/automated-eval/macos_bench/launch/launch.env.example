# Copy to $CDB_BENCH_WORK/launch.env (default ~/.cache/cua-bench-h2h/launch.env), then:
#   open -a Terminal launch/launch_bench.command
RUN_ID=main
# No new trial starts after this time (UTC). Set it before you launch.
CUTOFF_UTC=2026-10-08T06:00:00Z
EXTRA_ARGS=""
# Codex authentication: gateway (default) or chatgpt; model and effort are unchanged.
# ChatGPT mode needs an existing Codex ChatGPT login, not a gateway or key.
# Preflight checks account/model metadata only, with no model call.
# export CDB_CODEX_AUTH=chatgpt
# export CDB_CODEX_AUTH_FILE="$HOME/.codex/auth.json"  # optional override
# Trial auth.json files symlink this file, shared with the host and its clones.
# Refresh-token rotation can sign out the other copies.
# Inside the VM (Amendment 1 of the pre-registration) also export, in this file:
#   export CDB_BENCH_DISPOSABLE=1                  # the runner may kill Electron, Chrome, LibreOffice and GnuCash by name
#   export CDB_TASKPACK=$HOME/cdb-runtime          # agent-visible part of the private CDB task pack
#   export CDB_EVAL_SUDO=1                         # evaluator runs as the separate user cdbeval
#   export CDB_CLAUDE_TOKEN_FILE=$HOME/.cdb-secrets/claude-token   # 0600; handed to claude by file descriptor
