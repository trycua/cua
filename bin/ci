     ]),
    ("apps/cua-spaces-desktop", r"^apps/cua-spaces-desktop/", None, "pnpm install --frozen-lockfile", [
        ("typecheck", "typecheck", "pnpm typecheck", None),
        ("test", "tests and router contract", "pnpm test", None),
    ]),
    ("apps/cua-spaces", r"^(apps/cua-spaces/(?!src-tauri/)|libs/cua/crates/cua-spaces-app-core/)", None, "pnpm install --frozen-lockfile", [
        ("typecheck", "typecheck (builds the core wasm)", "pnpm typecheck", None),
        ("test", "vitest (app core parity)", "pnpm test", None),
    ]),
    ("libs/typescript", r"^libs/typescript/", None, "pnpm install --frozen-lockfile", [
        ("typecheck", "typecheck", "pnpm typecheck", None),
        ("format", "prettier", "pnpm format:check", "pnpm exec prettier --write ."),
    ]),
    ("libs/cua/typescript", r"^libs/cua/typescript/", "npm", "npm ci --ignore-scripts", [
        ("typecheck", "typecheck", "npm run typecheck", None),
    ]),
    ("libs/cua-driver/typescript", r"^libs/cua-driver/typescript/", "npm", "npm ci", [
        ("typecheck", "typecheck", "npm run typecheck", None),
    ]),
]

# Text CI must keep containing for each local check (checked by --verify-sync).
SYNC_REFS: List[Tuple[str, str, str]] = [
    # (check id prefix, workflow, text)
    ("rust-fmt", "ci-cua-sdk.yml", "-- --check"),
    ("rust-clippy", "ci-cua-sdk.yml", "--all-targets --features cua-daemon/test-fixtures,cua-media-client/media-decode,cua-spaces-cli/contrib-modal -- -D warnings"),
