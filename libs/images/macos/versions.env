# Pinned inputs of the macOS tiers (build.sh --tier, tiers.sh). One place:
# a monthly rebuild changes nothing unless this file changes. Every download
# is checked against its sha256 on the host before it is shared into the
# guest, and again in the guest before it is installed. image.json's tier
# claims (`expect`) must name the same versions (build.sh checks).
# Sourced by bash; KEY=value only.

# --- slim ---------------------------------------------------------------------
# The Lume base the slim tier starts from: a digest-stable pin (the first
# cua-spacesd macOS 26 image, macOS 26.5.2 25F84, SIP off, autologin lume).
# Never a floating tag: `26` becomes the full tier.
# (Repository and tag apart: the pin is not a catalog entry.)
MACOS_BASE_REPO=ghcr.io/trycua/macos
MACOS_BASE_TAG=26-20260925-3262e04
MACOS_BASE_DIGEST=sha256:b03ff1154dc80a7dadef5397eaca395c1e6cb64093a29bd53ca5916127816a8e
# Google Chrome (Omaha "release2" URL: a versioned, immutable download).
CHROME_VERSION=154.0.8037.58
CHROME_URL=https://dl.google.com/release2/chrome/esexjcwror2yyct27xsikjz3bq_154.0.8037.58/GoogleChrome-154.0.8037.58.dmg
CHROME_SHA256=2df467b9bbf5fa93e2a3b59b79906a8ebd9e3677d1b61857f6c9d99e62eacb43

# --- full ---------------------------------------------------------------------
# Xcode Command Line Tools: installed through softwareupdate when the guest's
# CLTools_Executables is not already this version.
CLT_VERSION=26.6
CLT_LABEL="Command Line Tools for Xcode 26.6-26.6"
# Homebrew: git clone of this tag, checked out at exactly this commit.
HOMEBREW_TAG=7.0.6
HOMEBREW_COMMIT=570982948a8a194f0f42f43f4a5bce2d1c9f64cb
GH_VERSION=2.101.0
GH_URL=https://github.com/cli/cli/releases/download/v2.101.0/gh_2.101.0_macOS_arm64.zip
GH_SHA256=e4303e39d8f07141c4bad4b99b01079f05029c59b27076e8fbc825c985ecdd8b
JQ_VERSION=1.8.2
JQ_URL=https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-macos-arm64
JQ_SHA256=2d75340ba57a4b4b4c8708a21c2dc8e958a48aaa8bba13b27f77f6e4c0eca07e
RG_VERSION=15.2.0
RG_URL=https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-aarch64-apple-darwin.tar.gz
RG_SHA256=3750b2e93f37e0c692657da574d7019a101c0084da05a790c83fd335bad973e4
# Node LTS (Krypton) and pnpm (npm tarball, installed from the verified file).
NODE_VERSION=24.21.0
NODE_URL=https://nodejs.org/dist/v24.21.0/node-v24.21.0-darwin-arm64.tar.gz
NODE_SHA256=bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057
PNPM_VERSION=12.6.0
PNPM_URL=https://registry.npmjs.org/pnpm/-/pnpm-12.6.0.tgz
PNPM_SHA256=05b7b921fbb31564505c967eabf825895a1cc18f50935c00be98815272cc9d56
UV_VERSION=0.12.19
UV_URL=https://github.com/astral-sh/uv/releases/download/0.12.19/uv-aarch64-apple-darwin.tar.gz
UV_SHA256=a9a8df1eedeb192f2e47e40e2faabfb387db4b850209118786d42f89dde3e0ba
# rustup-init, then this exact stable toolchain (minimal profile).
RUSTUP_VERSION=1.29.1
RUSTUP_URL=https://static.rust-lang.org/rustup/archive/1.29.1/aarch64-apple-darwin/rustup-init
RUSTUP_SHA256=ec1b9233e7f72990ecd8e62063fa7f6c3dfc2bec8e97f88bff165f9100ac696a
RUST_VERSION=1.98.1
GO_VERSION=1.27.1
GO_URL=https://go.dev/dl/go1.27.1.darwin-arm64.tar.gz
GO_SHA256=ee215d57e0ec269c60cc9ceca68e6bda321ba9ee5afe24f4b0988703c2d87d12

# --- xcode --------------------------------------------------------------------
# Apple needs a signed-in download, so the .xip comes from a runner-side
# cache (CUA_XCODE_CACHE, default ~/XcodesCache), never from the network.
# Apple and xcodereleases.com publish SHA-1 for the archive; xip also checks
# Apple's signature on expand.
XCODE_VERSION=26.6
XCODE_BUILD=17F113
XCODE_XIP=Xcode_26.6_Apple_silicon.xip
XCODE_XIP_SHA1=02ce6fccf6c46c12cbef005fbd48f9eaf7489912
# The iOS simulator runtime of that Xcode (xcodebuild -downloadPlatform iOS),
# the only runtime the tier claims (image.json simulator_runtimes).
XCODE_IOS_RUNTIME=26.5
