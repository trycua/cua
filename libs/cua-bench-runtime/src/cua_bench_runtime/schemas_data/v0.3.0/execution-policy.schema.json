{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cua.ai/cuabench/v0.3.0/execution-policy.schema.json",
  "title": "Cua-Bench Execution Policy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "limits",
    "network",
    "autonomy",
    "isolation",
    "permissions",
    "accounting",
    "credential_state_profile"
  ],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "limits": { "$ref": "#/$defs/limits" },
    "network": { "$ref": "#/$defs/network" },
    "autonomy": { "$ref": "#/$defs/autonomy" },
    "isolation": { "$ref": "#/$defs/isolation" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "accounting": { "$ref": "#/$defs/accounting" },
    "credential_state_profile": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proxyEndpoint": {
      "type": "string",
      "pattern": "^(?!127\\.)(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])@(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "total_tokens", "cost_usd", "attempts_per_task", "infrastructure_retries"],
      "properties": {
        "wall_time_ms": { "type": "integer", "minimum": 1 },
        "total_tokens": { "type": "integer", "minimum": 1 },
        "cost_usd": { "type": "number", "exclusiveMinimum": 0 },
        "attempts_per_task": { "type": "integer", "minimum": 1 },
        "infrastructure_retries": { "type": "integer", "minimum": 0 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "allowlist", "full"] },
        "allowlist_sha256": { "$ref": "#/$defs/sha256" },
        "proxy_endpoint": { "$ref": "#/$defs/proxyEndpoint" },
        "provider_allowlist_sha256": { "$ref": "#/$defs/sha256" },
        "proxy_implementation_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "allowlist" } } },
          "then": { "required": ["allowlist_sha256"] },
          "else": { "not": { "required": ["allowlist_sha256"] } }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["proxy_endpoint"] },
              { "required": ["provider_allowlist_sha256"] },
              { "required": ["proxy_implementation_sha256"] }
            ]
          },
          "then": {
            "properties": { "mode": { "const": "allowlist" } },
            "required": [
              "proxy_endpoint",
              "provider_allowlist_sha256",
              "proxy_implementation_sha256"
            ]
          }
        }
      ]
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "max_human_interventions", "approval_prompts"],
      "properties": {
        "required": { "const": true },
        "max_human_interventions": { "const": 0 },
        "approval_prompts": { "const": "count_as_intervention" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_harness_workspace", "target_reset", "persistent_cache", "package_installation"],
      "properties": {
        "fresh_harness_workspace": { "const": true },
        "target_reset": { "const": true },
        "persistent_cache": { "enum": ["forbidden", "declared_read_only"] },
        "package_installation": { "enum": ["forbidden", "ephemeral_declared"] }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "policy_sha256"],
      "properties": {
        "mode": { "enum": ["unrestricted", "sandboxed", "custom"] },
        "policy_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "cost_basis", "model_price_table", "includes_subagents"],
      "properties": {
        "currency": { "const": "USD" },
        "cost_basis": { "enum": ["provider_billed", "pinned_list_price"] },
        "model_price_table": { "$ref": "#/$defs/artifact" },
        "includes_subagents": { "const": true }
      }
    }
  }
}
