{
  "platform": "linux-hyprland",
  "descriptor_version": "1",
  "task_id": "IR-04",
  "app": "linux/benchlab.py",
  "app_args": [
    "--mode",
    "irconsent"
  ],
  "app_executable": "python3 linux/benchlab.py (GTK3, native Wayland; process name and app id BenchLab)",
  "sentinel": "hyprland/sentinel.py",
  "launcher": [
    "${python}",
    "launch/hyprland_session.py",
    "--task",
    "IR-04",
    "--run-index",
    "${run_index}",
    "--condition",
    "${condition}",
    "--out",
    "${artifacts}",
    "--",
    "${agent_command}"
  ],
  "conditions": [
    "foreground",
    "background"
  ],
  "evaluate": [
    "${python}",
    "probes/IR-04/evaluate.py",
    "--seed",
    "${seed}",
    "--state",
    "${artifacts}/state.json",
    "--events",
    "${artifacts}/events.jsonl",
    "--result",
    "${result}"
  ],
  "requires": [
    "Python 3.11 or later with PyGObject, GTK 3 and AT-SPI",
    "Hyprland 0.55 or later with a Lua config, hyprland/bench.lua loaded (1920x1080)",
    "wl-clipboard",
    "the desktop user's Hyprland session environment"
  ]
}
