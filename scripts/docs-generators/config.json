{
  "$schema": "./config.schema.json",
  "description": "Configuration for auto-generating documentation from source code",
  "generators": {
    "cua-driver": {
      "name": "Cua Driver",
      "language": "rust",
      "sourcePath": "libs/cua-driver/rust/crates",
      "docsOutputPath": "docs/content/docs/cua-driver/reference",
      "generatorScript": "scripts/docs-generators/cua-driver.ts",
      "watchPaths": [
        "libs/cua-driver/rust/crates/**/*.rs",
        "libs/cua-driver/rust/Cargo.toml",
        "libs/cua-driver/rust/Cargo.lock",
        "scripts/docs-generators/lib/**",
        "scripts/docs-generators/headers/cua-driver/**",
        "scripts/docs-generators/cua-driver-policy.test.ts",
        "scripts/docs-generators/cli-specs/cua-driver.json",
        "scripts/docs-generators/cli-specs/cua-driver-mcp-*.json",
        "docs/content/docs/cua-driver/reference/**"
      ],
      "buildCommand": "cargo build -p cua-driver --release",
      "buildDirectory": "libs/cua-driver/rust",
      "extractionMethod": "dump-docs",
      "outputs": [
        {
          "type": "index",
          "outputFile": "index.mdx",
          "extractCommand": "${CARGO_TARGET_DIR:-target}/release/cua-driver dump-docs --type all --pretty"
        },
        {
          "type": "cli",
          "outputFile": "cli/index.mdx",
          "extractCommand": "${CARGO_TARGET_DIR:-target}/release/cua-driver dump-docs --type cli"
        },
        {
          "type": "mcp",
          "outputFile": "mcp-tools/index.mdx",
          "extractCommand": "${CARGO_TARGET_DIR:-target}/release/cua-driver dump-docs --type mcp (plus the committed cli-specs/cua-driver-mcp-<platform>.json of the other platforms)"
        },
        {
          "type": "nav",
          "outputFile": "meta.json",
          "extractCommand": null
        }
      ],
      "enabled": true,
      "notes": "Renders reference/index.mdx, reference/cli/ (one page per command group) and reference/mcp-tools/ (one page per tool category) with the shared renderers in lib/. The CLI comes from the hand-maintained cli_docs_json() in crates/cua-driver/src/cli.rs (host independent). The MCP registry differs per OS: each host refreshes (or, with --check, verifies) its own snapshot cli-specs/cua-driver-mcp-<macos|linux|windows>.json and every page renders from the three committed snapshots, so the pages are identical on every host. Curated headers: scripts/docs-generators/headers/cua-driver/."
    },
    "lume": {
      "name": "Lume VM Manager",
      "language": "swift",
      "sourcePath": "libs/lume/src",
      "docsOutputPath": "docs/content/docs/lume/reference",
      "generatorScript": "scripts/docs-generators/lume.ts",
      "watchPaths": [
        "libs/lume/src/Commands/**/*.swift",
        "libs/lume/src/Server/**/*.swift",
        "libs/lume/src/Utils/CommandDocExtractor.swift",
        "libs/lume/src/Server/APIDocExtractor.swift",
        "scripts/docs-generators/lib/**",
        "scripts/docs-generators/headers/lume/**",
        "scripts/docs-generators/cli-specs/lume.json",
        "docs/content/docs/lume/reference/**"
      ],
      "buildCommand": "swift build -c release",
      "buildDirectory": "libs/lume",
      "extractionMethod": "dump-docs",
      "outputs": [
        {
          "type": "index",
          "outputFile": "index.mdx",
          "extractCommand": ".build/release/lume dump-docs --type all --pretty"
        },
        {
          "type": "cli",
          "outputFile": "cli/index.mdx",
          "extractCommand": ".build/release/lume dump-docs --type cli"
        },
        {
          "type": "api",
          "outputFile": "http-api.mdx",
          "extractCommand": ".build/release/lume dump-docs --type api"
        },
        {
          "type": "mcp",
          "outputFile": "mcp-tools.mdx",
          "extractCommand": ".build/release/lume dump-docs --type mcp"
        },
        {
          "type": "nav",
          "outputFile": "meta.json",
          "extractCommand": null
        }
      ],
      "enabled": true,
      "notes": "Renders reference/index.mdx, reference/cli/ (one page per command group), http-api.mdx and mcp-tools.mdx from `lume dump-docs --type all` with the shared renderers in lib/."
    },
    "cua-bench": {
      "name": "Cua Bench (cb CLI, task and result schemas)",
      "language": "python",
      "sourcePath": "libs/cua-bench/cua_bench",
      "docsOutputPath": "docs/content/docs/cua-bench/reference",
      "generatorScript": "scripts/docs-generators/cua-bench.ts",
      "watchPaths": [
        "libs/cua-bench/cua_bench/cli/**",
        "libs/cua-bench/cua_bench/core.py",
        "libs/cua-bench/cua_bench/decorators.py",
        "libs/cua-bench/cua_bench/types.py",
        "libs/cua-bench/cua_bench/results.py",
        "libs/cua-bench/cua_bench/runner/batch_runner.py",
        "libs/cua-bench/cua_bench/computers/base.py",
        "libs/cua-bench/cua_bench/computers/remote.py",
        "libs/cua-bench/cua_bench/tests/golden/*_schema.json",
        "libs/cua-bench/example_tasks/hello_file_env/main.py",
        "libs/cua-bench/pyproject.toml",
        "libs/cua-bench/uv.lock",
        "scripts/docs-generators/extract_cb_docs.py",
        "scripts/docs-generators/lib/**",
        "scripts/docs-generators/headers/cua-bench/**",
        "scripts/docs-generators/cli-specs/cb.json",
        "docs/content/docs/cua-bench/reference/**"
      ],
      "buildCommand": null,
      "buildDirectory": "libs/cua-bench",
      "extractionMethod": "argparse-introspection",
      "outputs": [
        {
          "type": "index",
          "outputFile": "index.mdx",
          "extractCommand": "uv run --frozen --python 3.12 --project libs/cua-bench python scripts/docs-generators/extract_cb_docs.py"
        },
        {
          "type": "cli",
          "outputFile": "cli/index.mdx",
          "extractCommand": null
        },
        {
          "type": "reference",
          "outputFile": "task-definition.mdx",
          "extractCommand": null
        },
        {
          "type": "reference",
          "outputFile": "results.mdx",
          "extractCommand": null
        },
        {
          "type": "nav",
          "outputFile": "meta.json",
          "extractCommand": null
        }
      ],
      "enabled": true,
      "notes": "Imports cua_bench in its project environment (uv) and introspects `build_parser()` (every command, flag and epilog example) plus the task contract (cb.Task, DesktopSetupConfig, the decorators, the session API, actions) and the result models (JobResult, HarborTrialFields, Summary), with field docs from `#:` comments. The result and summary key sets are checked against the export goldens in cua_bench/tests/golden."
    },
    "sandbox": {
      "name": "Sandbox package and image facts",
      "language": "typescript",
      "sourcePath": "libs/python/cua-sandbox",
      "docsOutputPath": "docs/content/docs/cua-sdk/reference",
      "generatorScript": "scripts/docs-generators/sandbox.ts",
      "watchPaths": [
        "libs/cua/python/pyproject.toml",
        "libs/typescript/fleet/package.json",
        "libs/cua-driver/hyprland-plugin/packaging/release/profiles/omarchy-stable-20260910.json",
        "scripts/docs-generators/sandbox-facts.json",
        "scripts/docs-generators/sandbox-facts.schema.json",
        "libs/images/sandbox-images.json",
        "libs/images/bench/*/lock.json",
        "docs/content/docs/cua-sdk/quickstart.mdx",
        "docs/content/docs/start-here/sandbox-images.mdx",
        "scripts/docs-generators/sandbox.test.ts",
        "scripts/docs-generators/headers/cua-sdk/runtime-support.md",
        "scripts/docs-generators/headers/cua-sdk/os-image-catalog.md",
        "scripts/docs-generators/image-software.ts",
        "libs/images/software/*.json",
        "scripts/docs-generators/lib/mdx.ts"
      ],
      "buildCommand": null,
      "buildDirectory": ".",
      "extractionMethod": "source-manifest",
      "outputs": [
        {
          "type": "reference",
          "outputFile": "runtime-support.mdx",
          "extractCommand": null
        },
        {
          "type": "reference",
          "outputFile": "os-image-catalog.mdx",
          "extractCommand": null
        },
        {
          "type": "reference",
          "outputFile": "image-software.mdx",
          "extractCommand": null
        }
      ],
      "enabled": true,
      "notes": "Generates runtime-support.mdx, os-image-catalog.mdx and image-software.mdx (the per-tier inventories under libs/images/software): the curated bodies in headers/cua-sdk/<page>.md with their GENERATED regions filled from public source manifests and schema-checked deployment qualification facts."
