{
  "platform": "macos",
  "descriptor_version": "1",
  "semantics": {
    "task_id": "cua.v2.ds04-lichen-guide-headings",
    "task_version": "1.0.0",
    "brief": "brief.md",
    "reset": {
      "setup": [
        "${python}",
        "reset/setup.py",
        "--workspace",
        "${workspace}"
      ],
      "verify": [
        "${python}",
        "reset/verify.py",
        "--workspace",
        "${workspace}"
      ]
    },
    "evaluate": [
      "${python}",
      "evaluator/evaluate.py",
      "--workspace",
      "${workspace}",
      "--artifacts",
      "${artifacts}",
      "--result",
      "${result}",
      "--agent-exit-code",
      "${agent_exit_code}"
    ],
    "required_apps": [
      "LibreOffice Writer"
    ]
  },
  "workspace_root": "${HOME}/v2-ds04",
  "apps": [
    {
      "id": "office",
      "kind": "office",
      "role": "LibreOffice writer",
      "command": [
        "/Applications/LibreOffice.app/Contents/MacOS/soffice",
        "--writer",
        "--norestore",
        "--nodefault",
        "--nolockcheck",
        "-env:UserInstallation=${workspace_uri}/.runtime/libreoffice",
        "${workspace}/guide.fodt"
      ],
      "process_names": [
        "soffice",
        "soffice.bin"
      ],
      "window": {
        "title_contains": "guide.fodt",
        "bounds": {
          "x": 40,
          "y": 40,
          "width": 1280,
          "height": 900
        }
      }
    }
  ]
}
