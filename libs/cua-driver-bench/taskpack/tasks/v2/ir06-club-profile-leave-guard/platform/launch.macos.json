{
  "platform": "macos",
  "descriptor_version": "1",
  "semantics": {
    "task_id": "cua.v2.ir06-club-profile-leave-guard",
    "task_version": "1.0.0",
    "brief": "brief.md",
    "reset": {
      "setup": [
        "${python}",
        "reset/setup.py",
        "--workspace",
        "${workspace}"
      ],
      "verify": [
        "${python}",
        "reset/verify.py",
        "--workspace",
        "${workspace}"
      ]
    },
    "evaluate": [
      "${python}",
      "evaluator/evaluate.py",
      "--workspace",
      "${workspace}",
      "--artifacts",
      "${artifacts}",
      "--result",
      "${result}",
      "--agent-exit-code",
      "${agent_exit_code}"
    ],
    "required_apps": [
      "Google Chrome"
    ]
  },
  "workspace_root": "${HOME}/v2-ir06",
  "apps": [
    {
      "id": "site",
      "kind": "service",
      "role": "the task's local web app (loopback only)",
      "command": [
        "${python}",
        "${bundle}/../_kit/v2kit/serve.py",
        "--app",
        "${bundle}/app",
        "--state-dir",
        "${workspace}/state",
        "--port",
        "4406",
        "--initial",
        "${bundle}/app/initial-state.json"
      ],
      "ready": {
        "http": "http://127.0.0.1:4406/healthz",
        "timeout_seconds": 15
      }
    },
    {
      "id": "browser",
      "kind": "browser",
      "role": "Google Chrome on the task's local page",
      "command": [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-default-apps",
        "--disable-sync",
        "--disable-features=Translate,PasswordManagerOnboarding,AutofillServerCommunication",
        "--user-data-dir=${workspace}/.runtime/chrome",
        "--new-window",
        "http://127.0.0.1:4406/profile.html"
      ],
      "window": {
        "title_contains": "Coppergate Cycling Club",
        "bounds": {
          "x": 40,
          "y": 40,
          "width": 1240,
          "height": 900
        }
      }
    }
  ]
}
