<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Contents/Resources/native/cua (com.trycua.cua), the Cua Spaces build of the
  cua CLI and daemon the app bundles: Developer ID with the hardened runtime
  (packaging/sign-mac.cjs). The same entitlements the SwiftUI app signs its
  `cua` with (apps/cua-spaces-macos/Support/cua.entitlements).

  - automation.apple-events: the daemon runs App Teleport, which drives
    browsers with osascript. From a terminal the terminal app is the
    responsible process; this keeps the hardened `cua` from being the reason
    an Apple Event is refused.

  Nothing else: no JIT (that is the app's, for V8), no library-validation
  exception and no keychain access groups. The vault key is a login keychain
  item whose access list trusts this binary's requirement (team plus
  identifier), not an access group, so it needs no provisioning profile.
  Touch ID (LocalAuthentication) is a prompt, not an entitlement, outside
  the App Sandbox.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
