{
  "name": "cyclops-cs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sdk:browser": "./scripts/ensure-browser-sdk-binding.sh",
    "dev": "npm run sdk:browser && vite",
    "build": "npm run sdk:browser && npm run build:app",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run sdk:browser && tsc -b --noEmit && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck agent.test.ts src/browser-agent.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test:e2e": "npm run sdk:browser && playwright test",
    "test:e2e:ui": "npm run sdk:browser && playwright test --ui",
    "test:auth-contract": "tsx --test tests/auth-redirects.test.ts && node --test tests/auth-first-paint.test.mjs",
    "test:error-message": "tsx --test tests/error-message.test.ts",
    "test:design-boundary": "node --test tests/design-package-boundary.test.mjs",
    "test:favicon": "node --test tests/favicon.test.mjs",
    "test:sdk-models": "rm -rf target/sdk-model-tests && tsc -p tsconfig.sdk-models.json && node target/sdk-model-tests/e2e/sdk-models.unit.js",
    "test:agent": "tsx --test agent.test.ts"
  },
  "dependencies": {
    "@cua/design": "file:../packages/cua-design",
    "@cloudscape-design/collection-hooks": "^1.0.93",
    "@cloudscape-design/components": "^3.0.825",
    "@cloudscape-design/global-styles": "^1.0.36",
    "@melloware/react-logviewer": "6.5.5",
    "@novnc/novnc": "^1.7.0",
    "@ubjs/core": "0.31.0-3",
    "ansi-to-html": "^0.7.2",
    "keycloak-js": "^25.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.28.0",
    "@cloudscape-design/chat-components": "^1.0.157",
    "just-bash": "^3.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "4.22.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "@types/node": "^22.19.17"
  }
}
